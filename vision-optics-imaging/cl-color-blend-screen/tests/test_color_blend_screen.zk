// cl-color-blend-screen: Test Suite
import "../c_scr.zk"

fn test_blend():
    res := blend_screen(0.50, 0.50)
    diff := res - 0.75
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_blend()
    print("✓ All tests passed for cl-color-blend-screen!")
