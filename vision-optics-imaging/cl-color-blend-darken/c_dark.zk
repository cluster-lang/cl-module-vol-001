// cl-color-blend-darken: Color Darken Blend Mode per Channel
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn blend_darken(base: float, blend: float) -> float:
    if base < blend: return base
    return blend
