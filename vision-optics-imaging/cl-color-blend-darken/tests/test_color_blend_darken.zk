// cl-color-blend-darken: Test Suite
import "../c_dark.zk"

fn test_blend():
    res := blend_darken(0.70, 0.30)
    diff := res - 0.30
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_blend()
    print("✓ All tests passed for cl-color-blend-darken!")
