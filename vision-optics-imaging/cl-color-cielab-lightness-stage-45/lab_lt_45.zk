// cl-color-cielab-lightness-stage-45: CIELAB Lightness Linear Range Stage 45
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cielab_lightness_45(y_norm: float) -> float:
    return (116.0 * y_norm - 16.0) * 45.0
