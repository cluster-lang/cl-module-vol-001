// cl-color-d65-white-bias-stage-2: Test Suite
import "../d65_bl_2.zk"

fn test_run():
    res := d65_white_balance_2(10.0)
    diff := res - 21.7766
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-d65-white-bias-stage-2!")
