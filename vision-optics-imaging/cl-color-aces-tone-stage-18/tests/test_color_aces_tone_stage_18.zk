import "../aces_t_18.zk"

fn test_run():
    res := aces_tone_18(1.0)
    diff := res - 1.4468
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
