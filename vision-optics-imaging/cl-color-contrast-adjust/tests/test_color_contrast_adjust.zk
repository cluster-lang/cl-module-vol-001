// cl-color-contrast-adjust: Test Suite
import "../c_cntr.zk"

fn test_col():
    res := color_contrast_adjust(0.6, 2.0)
    diff := res - 0.7000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_col()
    print("✓ All tests passed for cl-color-contrast-adjust!")
