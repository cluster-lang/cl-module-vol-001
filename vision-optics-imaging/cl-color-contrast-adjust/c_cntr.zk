// cl-color-contrast-adjust: Linear Contrast Adjustment around Mid-Gray
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn color_contrast_adjust(c: float, contrast: float) -> float:
    res := 0.5 + contrast * (c - 0.5)
    if res < 0.0: return 0.0
    if res > 1.0: return 1.0
    return res
