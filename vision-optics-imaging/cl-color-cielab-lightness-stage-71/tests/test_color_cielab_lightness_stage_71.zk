// cl-color-cielab-lightness-stage-71: Test Suite
import "../lab_lt_71.zk"

fn test_run():
    res := cielab_lightness_71(0.5)
    diff := res - 2982.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-cielab-lightness-stage-71!")
