// cl-color-d65-white-bias-stage-16: Test Suite
import "../d65_bl_16.zk"

fn test_run():
    res := d65_white_balance_16(10.0)
    diff := res - 174.2128
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-d65-white-bias-stage-16!")
