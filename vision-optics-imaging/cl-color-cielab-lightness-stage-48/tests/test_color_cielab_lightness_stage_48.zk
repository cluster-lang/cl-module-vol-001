// cl-color-cielab-lightness-stage-48: Test Suite
import "../lab_lt_48.zk"

fn test_run():
    res := cielab_lightness_48(0.5)
    diff := res - 2016.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-cielab-lightness-stage-48!")
