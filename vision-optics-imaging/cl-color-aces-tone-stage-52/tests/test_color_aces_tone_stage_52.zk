// cl-color-aces-tone-stage-52: Test Suite
import "../aces_t_52.zk"

fn test_run():
    res := aces_tone_52(1.0)
    diff := res - 4.1797
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
