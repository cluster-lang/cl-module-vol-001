// cl-color-cie-u-prime-stage-78: Test Suite
import "../cie_up_78.zk"

fn test_run():
    res := cie_u_prime_78(1.0, 1.0, 1.0)
    diff := res - 16.4211
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-cie-u-prime-stage-78!")
