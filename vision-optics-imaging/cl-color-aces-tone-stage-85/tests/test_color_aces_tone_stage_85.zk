// cl-color-aces-tone-stage-85: Test Suite
import "../aces_t_85.zk"

fn test_run():
    res := aces_tone_85(1.0)
    diff := res - 6.8323
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-aces-tone-stage-85!")
