// cl-color-blend-color-dodge: Test Suite
import "../c_dodge.zk"

fn test_blend():
    res := blend_color_dodge(0.25, 0.50)
    diff := res - 0.50
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_blend()
    print("✓ All tests passed for cl-color-blend-color-dodge!")
