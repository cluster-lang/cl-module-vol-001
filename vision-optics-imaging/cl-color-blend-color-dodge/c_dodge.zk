// cl-color-blend-color-dodge: Color Dodge Blend Mode per Channel
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn blend_color_dodge(base: float, blend: float) -> float:
    if blend >= 1.0: return 1.0
    res := base / (1.0 - blend)
    if res > 1.0: return 1.0
    return res
