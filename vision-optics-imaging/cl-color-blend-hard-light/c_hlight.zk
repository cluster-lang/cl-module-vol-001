// cl-color-blend-hard-light: Color Hard Light Blend Mode per Channel
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn blend_hard_light(base: float, blend: float) -> float:
    if blend <= 0.5: return 2.0 * base * blend
    return 1.0 - 2.0 * (1.0 - base) * (1.0 - blend)
