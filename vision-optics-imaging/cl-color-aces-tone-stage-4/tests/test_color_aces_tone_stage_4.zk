// cl-color-aces-tone-stage-4: Test Suite
import "../aces_t_4.zk"

fn test_run():
    res := aces_tone_4(1.0)
    diff := res - 0.3215
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-aces-tone-stage-4!")
