// cl-color-blend-difference: Color Difference Blend Mode per Channel
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn blend_difference(base: float, blend: float) -> float:
    diff := base - blend
    if diff < 0.0: return 0.0 - diff
    return diff
