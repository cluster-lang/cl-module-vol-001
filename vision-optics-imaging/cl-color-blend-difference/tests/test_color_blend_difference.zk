// cl-color-blend-difference: Test Suite
import "../c_diff.zk"

fn test_blend():
    res := blend_difference(0.80, 0.30)
    diff := res - 0.50
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_blend()
    print("✓ All tests passed for cl-color-blend-difference!")
