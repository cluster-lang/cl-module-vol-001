// cl-color-aces-tone-stage-50: Test Suite
import "../aces_t_50.zk"

fn test_run():
    res := aces_tone_50(1.0)
    diff := res - 4.0190
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-aces-tone-stage-50!")
