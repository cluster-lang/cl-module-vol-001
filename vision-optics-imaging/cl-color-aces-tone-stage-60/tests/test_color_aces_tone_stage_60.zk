// cl-color-aces-tone-stage-60: Test Suite
import "../aces_t_60.zk"

fn test_run():
    res := aces_tone_60(1.0)
    diff := res - 4.8228
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-aces-tone-stage-60!")
