// cl-color-aces-tone-stage-86: Test Suite
import "../aces_t_86.zk"

fn test_run():
    res := aces_tone_86(1.0)
    diff := res - 6.9127
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
