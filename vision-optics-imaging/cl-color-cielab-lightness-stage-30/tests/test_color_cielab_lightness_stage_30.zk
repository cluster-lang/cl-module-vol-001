// cl-color-cielab-lightness-stage-30: Test Suite
import "../lab_lt_30.zk"

fn test_run():
    res := cielab_lightness_30(0.5)
    diff := res - 1260.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-cielab-lightness-stage-30!")
