// cl-color-d50-white-bias-stage-34: Test Suite
import "../d50_bl_34.zk"

fn test_run():
    res := d50_white_balance_34(10.0)
    diff := res - 280.5714
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-d50-white-bias-stage-34!")
