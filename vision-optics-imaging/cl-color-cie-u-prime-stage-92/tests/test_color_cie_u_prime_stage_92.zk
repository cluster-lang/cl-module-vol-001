fn test_run():
    res := cie_u_prime_92(1.0, 1.0, 1.0)
    diff := res - 19.3684
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
