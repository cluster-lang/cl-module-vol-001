// cl-color-cie-u-prime-stage-97: Test Suite
import "../cie_up_97.zk"

fn test_run():
    res := cie_u_prime_97(1.0, 1.0, 1.0)
    diff := res - 20.4211
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
