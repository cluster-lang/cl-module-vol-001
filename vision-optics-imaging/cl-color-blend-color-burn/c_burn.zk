// cl-color-blend-color-burn: Color Burn Blend Mode per Channel
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn blend_color_burn(base: float, blend: float) -> float:
    if blend <= 0.0: return 0.0
    res := 1.0 - (1.0 - base) / blend
    if res < 0.0: return 0.0
    return res
