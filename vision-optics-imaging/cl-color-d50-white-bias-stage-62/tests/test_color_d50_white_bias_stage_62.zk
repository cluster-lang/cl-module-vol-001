// cl-color-d50-white-bias-stage-62: Test Suite
import "../d50_bl_62.zk"

fn test_run():
    res := d50_white_balance_62(10.0)
    diff := res - 511.6302
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-d50-white-bias-stage-62!")
