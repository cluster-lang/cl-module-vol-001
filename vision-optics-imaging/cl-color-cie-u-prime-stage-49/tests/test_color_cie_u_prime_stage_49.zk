// cl-color-cie-u-prime-stage-49: Test Suite
import "../cie_up_49.zk"

fn test_run():
    res := cie_u_prime_49(1.0, 1.0, 1.0)
    diff := res - 10.3158
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-cie-u-prime-stage-49!")
