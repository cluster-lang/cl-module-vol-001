// cl-color-blend-multiply: Test Suite
import "../c_mul.zk"

fn test_blend():
    res := blend_multiply(0.50, 0.50)
    diff := res - 0.25
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_blend()
    print("✓ All tests passed for cl-color-blend-multiply!")
