// cl-color-cie-u-prime-stage-53: Test Suite
import "../cie_up_53.zk"

fn test_run():
    res := cie_u_prime_53(1.0, 1.0, 1.0)
    diff := res - 11.1579
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-cie-u-prime-stage-53!")
