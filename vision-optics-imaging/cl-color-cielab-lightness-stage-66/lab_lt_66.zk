// cl-color-cielab-lightness-stage-66: CIELAB Lightness Linear Range Stage 66
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cielab_lightness_66(y_norm: float) -> float:
    return (116.0 * y_norm - 16.0) * 66.0
