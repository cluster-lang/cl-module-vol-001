// cl-color-blend-exclusion: Test Suite
import "../c_excl.zk"

fn test_blend():
    res := blend_exclusion(0.50, 0.50)
    diff := res - 0.50
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_blend()
    print("✓ All tests passed for cl-color-blend-exclusion!")
