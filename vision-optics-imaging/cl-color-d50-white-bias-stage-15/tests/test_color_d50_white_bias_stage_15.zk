// cl-color-d50-white-bias-stage-15: Test Suite
import "../d50_bl_15.zk"

fn test_run():
    res := d50_white_balance_15(10.0)
    diff := res - 123.7815
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-d50-white-bias-stage-15!")
