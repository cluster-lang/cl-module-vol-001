// cl-color-brightness-adjust: Color Brightness Additive Offset with Saturation Clamp
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn color_brightness_adjust(c: float, offset: float) -> float:
    res := c + offset
    if res < 0.0: return 0.0
    if res > 1.0: return 1.0
    return res
