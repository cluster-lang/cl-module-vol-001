// cl-color-brightness-adjust: Test Suite
import "../c_brt.zk"

fn test_col():
    res := color_brightness_adjust(0.6, 0.2)
    diff := res - 0.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_col()
    print("✓ All tests passed for cl-color-brightness-adjust!")
