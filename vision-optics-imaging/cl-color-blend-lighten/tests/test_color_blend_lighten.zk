// cl-color-blend-lighten: Test Suite
import "../c_light.zk"

fn test_blend():
    res := blend_lighten(0.70, 0.30)
    diff := res - 0.70
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_blend()
    print("✓ All tests passed for cl-color-blend-lighten!")
