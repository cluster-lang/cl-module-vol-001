// cl-color-cielab-lightness-stage-93: Test Suite
import "../lab_lt_93.zk"

fn test_run():
    res := cielab_lightness_93(0.5)
    diff := res - 3906.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-color-cielab-lightness-stage-93!")
