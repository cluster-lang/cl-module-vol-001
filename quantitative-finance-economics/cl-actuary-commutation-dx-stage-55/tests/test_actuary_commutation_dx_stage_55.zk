// cl-actuary-commutation-dx-stage-55: Test Suite
import "../act_dx_55.zk"

fn test_run():
    res := actuary_dx_55(1000.0)
    diff := res - 735.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-actuary-commutation-dx-stage-55!")
