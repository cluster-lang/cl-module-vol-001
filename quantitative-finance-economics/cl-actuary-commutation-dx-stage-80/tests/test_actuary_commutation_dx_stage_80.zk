// cl-actuary-commutation-dx-stage-80: Test Suite
import "../act_dx_80.zk"

fn test_run():
    res := actuary_dx_80(1000.0)
    diff := res - 950.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-actuary-commutation-dx-stage-80!")
