// cl-chem-torsion-dihedral-stage-80: Test Suite
import "../ch_te_80.zk"

fn test_run():
    res := dihedral_energy_80(12.0, 0.5)
    diff := res - 720.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-torsion-dihedral-stage-80!")
