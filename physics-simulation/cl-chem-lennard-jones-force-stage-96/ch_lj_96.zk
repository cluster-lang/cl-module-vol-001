// cl-chem-lennard-jones-force-stage-96: Lennard-Jones Intermolecular Force Magnitude Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lj_force_96(eps: float, sig: float, r: float) -> float:
    return (eps * sig / r) * 96.0
