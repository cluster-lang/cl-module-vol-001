// cl-cfd-sound-speed-stage-38: Test Suite
import "../cfd_ss_38.zk"

fn test_run():
    res := sound_speed_38(300.0)
    diff := res - 13207.7018
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-38!")
