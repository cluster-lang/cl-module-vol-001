// cl-cfd-sound-speed-stage-8: Test Suite
import "../cfd_ss_8.zk"

fn test_run():
    res := sound_speed_8(300.0)
    diff := res - 2780.5688
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-8!")
