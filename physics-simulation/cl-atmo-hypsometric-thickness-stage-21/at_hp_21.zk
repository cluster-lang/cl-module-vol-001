// cl-atmo-hypsometric-thickness-stage-21: Hypsometric Pressure Layer Geopotential Thickness Stage 21
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn layer_thickness_21(rd: float, t_avg: float, g0: float, log_p: float) -> float:
    return ((rd * t_avg / g0) * log_p) * 21.0
