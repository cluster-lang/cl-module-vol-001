// cl-atmo-potential-temperature-theta-stage-71: Test Suite
import "../at_pt_71.zk"

fn test_run():
    res := theta_factor_71(300.0, 1.1)
    diff := res - 21909.1800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-71!")
