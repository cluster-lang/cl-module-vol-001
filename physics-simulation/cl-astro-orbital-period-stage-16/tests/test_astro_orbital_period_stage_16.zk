// cl-astro-orbital-period-stage-16: Test Suite
import "../ast_op_16.zk"

fn test_run():
    res := orbital_period_16(100.0)
    diff := res - 197.4400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-16!")
