// cl-atmo-coriolis-parameter-stage-83: Coriolis Earth Planetary Acceleration Parameter Stage 83
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn coriolis_param_83(omega: float, sin_lat: float) -> float:
    return (2.0 * omega * sin_lat) * 83.0
