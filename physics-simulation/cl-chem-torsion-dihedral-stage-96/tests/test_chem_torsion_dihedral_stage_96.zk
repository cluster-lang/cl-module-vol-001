// cl-chem-torsion-dihedral-stage-96: Test Suite
import "../ch_te_96.zk"

fn test_run():
    res := dihedral_energy_96(12.0, 0.5)
    diff := res - 864.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-torsion-dihedral-stage-96!")
