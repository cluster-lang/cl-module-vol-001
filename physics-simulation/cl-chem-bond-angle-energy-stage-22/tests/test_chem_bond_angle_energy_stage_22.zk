import "../ch_ae_22.zk"

fn test_run():
    res := angle_energy_22(100.0, 0.1)
    diff := res - 11.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
