// cl-atmo-geostrophic-wind-u-stage-41: Test Suite
import "../at_gw_41.zk"

fn test_run():
    res := geostrophic_u_41(9.8, 0.0001, 0.0002)
    diff := res - 803.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-geostrophic-wind-u-stage-41!")
