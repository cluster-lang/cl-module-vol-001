// cl-atmo-coriolis-parameter-stage-52: Coriolis Earth Planetary Acceleration Parameter Stage 52
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn coriolis_param_52(omega: float, sin_lat: float) -> float:
    return (2.0 * omega * sin_lat) * 52.0
