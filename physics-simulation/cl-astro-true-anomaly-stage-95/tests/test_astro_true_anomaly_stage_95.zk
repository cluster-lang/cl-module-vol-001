// cl-astro-true-anomaly-stage-95: Test Suite
import "../ast_ta_95.zk"

fn test_run():
    res := true_anomaly_scale_95(0.2)
    diff := res - 115.9000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-95!")
