// cl-astro-escape-vel-sq-stage-66: Orbital Escape Velocity Squared Stage 66
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn escape_vel_sq_66(mu: float, r: float) -> float:
    if r <= 0.0001: return 0.0
    return (2.0 * mu / r) * 66.0
