import "../esc_v2_66.zk"

fn test_run():
    res := escape_vel_sq_66(500.0, 10.0)
    diff := res - 6600.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
