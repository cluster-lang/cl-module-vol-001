// cl-atmo-hypsometric-thickness-stage-77: Hypsometric Pressure Layer Geopotential Thickness Stage 77
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn layer_thickness_77(rd: float, t_avg: float, g0: float, log_p: float) -> float:
    return ((rd * t_avg / g0) * log_p) * 77.0
