// cl-astro-orbital-period-stage-48: Test Suite
import "../ast_op_48.zk"

fn test_run():
    res := orbital_period_48(100.0)
    diff := res - 592.3200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-48!")
