// cl-atmo-hypsometric-thickness-stage-1: Test Suite
import "../at_hp_1.zk"

fn test_run():
    res := layer_thickness_1(287.05, 250.0, 9.80665, 0.6931)
    diff := res - 5071.9245
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-hypsometric-thickness-stage-1!")
