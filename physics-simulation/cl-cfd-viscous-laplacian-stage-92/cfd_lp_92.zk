// cl-cfd-viscous-laplacian-stage-92: CFD Viscous Laplacian Dissipation Stage 92
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn viscous_laplacian_92(up: float, uc: float, um: float) -> float:
    return (up - 2.0 * uc + um) * 92.0
