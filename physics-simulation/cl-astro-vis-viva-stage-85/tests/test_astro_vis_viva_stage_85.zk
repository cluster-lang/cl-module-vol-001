// cl-astro-vis-viva-stage-85: Test Suite
import "../vis_vv_85.zk"

fn test_run():
    res := vis_viva_component_85(2.0, 4.0)
    diff := res - 63.7500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
