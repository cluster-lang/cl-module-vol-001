// cl-cfd-sound-speed-stage-71: Test Suite
import "../cfd_ss_71.zk"

fn test_run():
    res := sound_speed_71(300.0)
    diff := res - 24677.5481
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-71!")
