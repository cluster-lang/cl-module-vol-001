// cl-chem-torsion-dihedral-stage-59: Dihedral Torsional Angle Energy Stage 59
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn dihedral_energy_59(vn: float, cos_nphi: float) -> float:
    return 0.5 * vn * (1.0 + cos_nphi) * 59.0
