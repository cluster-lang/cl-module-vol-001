// cl-chem-morse-potential-stage-19: Test Suite
import "../ch_mp_19.zk"

fn test_run():
    res := morse_pot_19(5.0, 1.2, 0.1)
    diff := res - 83.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-morse-potential-stage-19!")
