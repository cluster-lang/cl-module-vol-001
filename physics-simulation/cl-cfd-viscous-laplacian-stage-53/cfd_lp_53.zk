// cl-cfd-viscous-laplacian-stage-53: CFD Viscous Laplacian Dissipation Stage 53
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn viscous_laplacian_53(up: float, uc: float, um: float) -> float:
    return (up - 2.0 * uc + um) * 53.0
