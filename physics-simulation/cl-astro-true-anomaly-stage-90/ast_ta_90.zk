// cl-astro-true-anomaly-stage-90: True Anomaly Scaling Ratio Stage 90
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn true_anomaly_scale_90(ecc: float) -> float:
    return (1.0 + ecc + 0.5 * ecc * ecc) * 90.0
