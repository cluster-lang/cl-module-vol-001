// cl-chem-lennard-jones-force-stage-85: Test Suite
import "../ch_lj_85.zk"

fn test_run():
    res := lj_force_85(1.5, 3.4, 2.0)
    diff := res - 216.7500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-lennard-jones-force-stage-85!")
