// cl-chem-morse-potential-stage-86: Morse Interatomic Potential Approximation Stage 86
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn morse_pot_86(de: float, a: float, dr: float) -> float:
    return de * (1.0 - a * dr) * 86.0
