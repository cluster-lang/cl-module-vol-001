// cl-chem-lennard-jones-force-stage-81: Lennard-Jones Intermolecular Force Magnitude Stage 81
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lj_force_81(eps: float, sig: float, r: float) -> float:
    return (eps * sig / r) * 81.0
