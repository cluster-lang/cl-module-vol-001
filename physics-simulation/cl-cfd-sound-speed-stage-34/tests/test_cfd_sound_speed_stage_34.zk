// cl-cfd-sound-speed-stage-34: Test Suite
import "../cfd_ss_34.zk"

fn test_run():
    res := sound_speed_34(300.0)
    diff := res - 11817.4174
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-34!")
