import "../ch_mp_54.zk"

fn test_run():
    res := morse_pot_54(5.0, 1.2, 0.1)
    diff := res - 237.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
