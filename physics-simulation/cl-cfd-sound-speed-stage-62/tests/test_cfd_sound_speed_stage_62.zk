// cl-cfd-sound-speed-stage-62: Test Suite
import "../cfd_ss_62.zk"

fn test_run():
    res := sound_speed_62(300.0)
    diff := res - 21549.4082
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-62!")
