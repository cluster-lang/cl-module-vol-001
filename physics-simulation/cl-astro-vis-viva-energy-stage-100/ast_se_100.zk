// cl-astro-vis-viva-energy-stage-100: Specific Orbital Energy Vis-Viva Stage 100
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_100(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 100.0
