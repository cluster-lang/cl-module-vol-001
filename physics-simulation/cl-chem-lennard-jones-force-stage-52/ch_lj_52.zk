// cl-chem-lennard-jones-force-stage-52: Lennard-Jones Intermolecular Force Magnitude Stage 52
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lj_force_52(eps: float, sig: float, r: float) -> float:
    return (eps * sig / r) * 52.0
