// cl-atmo-potential-temperature-theta-stage-12: Test Suite
import "../at_pt_12.zk"

fn test_run():
    res := theta_factor_12(300.0, 1.1)
    diff := res - 3702.9600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-12!")
