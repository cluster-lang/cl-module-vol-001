// cl-cfd-pressure-poisson-stage-20: Test Suite
import "../cfd_ps_20.zk"

fn test_run():
    res := pressure_source_20(1.225, 0.05)
    diff := res - 1.2250
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-pressure-poisson-stage-20!")
