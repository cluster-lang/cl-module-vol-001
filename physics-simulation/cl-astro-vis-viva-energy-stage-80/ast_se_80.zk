// cl-astro-vis-viva-energy-stage-80: Specific Orbital Energy Vis-Viva Stage 80
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_80(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 80.0
