// cl-chem-lennard-jones-force-stage-33: Lennard-Jones Intermolecular Force Magnitude Stage 33
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lj_force_33(eps: float, sig: float, r: float) -> float:
    return (eps * sig / r) * 33.0
