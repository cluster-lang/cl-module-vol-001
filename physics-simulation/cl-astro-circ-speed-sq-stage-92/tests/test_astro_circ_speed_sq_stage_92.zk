// cl-astro-circ-speed-sq-stage-92: Test Suite
import "../circ_v2_92.zk"

fn test_run():
    res := circ_orbital_speed_sq_92(1000.0, 50.0)
    diff := res - 1840.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-circ-speed-sq-stage-92!")
