// cl-cfd-sound-speed-stage-80: Test Suite
import "../cfd_ss_80.zk"

fn test_run():
    res := sound_speed_80(300.0)
    diff := res - 27805.6880
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-80!")
