// cl-astro-hohmann-dv-stage-30: Hohmann Transfer Orbit Speed Factor Stage 30
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn hohmann_factor_30(r1: float, r2: float) -> float:
    return (2.0 * r2 / (r1 + r2)) * 30.0
