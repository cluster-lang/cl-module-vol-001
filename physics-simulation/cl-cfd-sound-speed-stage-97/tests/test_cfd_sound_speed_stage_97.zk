// cl-cfd-sound-speed-stage-97: Test Suite
import "../cfd_ss_97.zk"

fn test_run():
    res := sound_speed_97(300.0)
    diff := res - 33714.3967
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-97!")
