// cl-cfd-sound-speed-stage-95: Test Suite
import "../cfd_ss_95.zk"

fn test_run():
    res := sound_speed_95(300.0)
    diff := res - 33019.2545
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-95!")
