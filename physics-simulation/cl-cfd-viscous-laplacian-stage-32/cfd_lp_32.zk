// cl-cfd-viscous-laplacian-stage-32: CFD Viscous Laplacian Dissipation Stage 32
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn viscous_laplacian_32(up: float, uc: float, um: float) -> float:
    return (up - 2.0 * uc + um) * 32.0
