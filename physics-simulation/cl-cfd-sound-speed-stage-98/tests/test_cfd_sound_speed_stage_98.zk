// cl-cfd-sound-speed-stage-98: Test Suite
import "../cfd_ss_98.zk"

fn test_run():
    res := sound_speed_98(300.0)
    diff := res - 34061.9678
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
