// cl-astro-circ-speed-sq-stage-34: Test Suite
import "../circ_v2_34.zk"

fn test_run():
    res := circ_orbital_speed_sq_34(1000.0, 50.0)
    diff := res - 680.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-circ-speed-sq-stage-34!")
