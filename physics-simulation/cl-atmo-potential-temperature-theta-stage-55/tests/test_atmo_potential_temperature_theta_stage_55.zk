// cl-atmo-potential-temperature-theta-stage-55: Test Suite
import "../at_pt_55.zk"

fn test_run():
    res := theta_factor_55(300.0, 1.1)
    diff := res - 16971.9000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-55!")
