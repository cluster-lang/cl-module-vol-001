// cl-astro-true-anomaly-stage-18: Test Suite
import "../ast_ta_18.zk"

fn test_run():
    res := true_anomaly_scale_18(0.2)
    diff := res - 21.9600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-18!")
