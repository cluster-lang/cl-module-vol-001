// cl-atmo-dewpoint-approx-magnus-stage-86: Test Suite
import "../at_dp_86.zk"

fn test_run():
    res := dewpoint_step_86(25.0, 80.0)
    diff := res - 1806.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-dewpoint-approx-magnus-stage-86!")
