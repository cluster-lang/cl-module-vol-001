// cl-atmo-geostrophic-wind-u-stage-100: Test Suite
import "../at_gw_100.zk"

fn test_run():
    res := geostrophic_u_100(9.8, 0.0001, 0.0002)
    diff := res - 1960.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-geostrophic-wind-u-stage-100!")
