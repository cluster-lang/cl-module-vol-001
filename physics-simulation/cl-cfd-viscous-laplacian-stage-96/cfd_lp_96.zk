// cl-cfd-viscous-laplacian-stage-96: CFD Viscous Laplacian Dissipation Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn viscous_laplacian_96(up: float, uc: float, um: float) -> float:
    return (up - 2.0 * uc + um) * 96.0
