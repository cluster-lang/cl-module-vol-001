// cl-atmo-geostrophic-wind-u-stage-43: Test Suite
import "../at_gw_43.zk"

fn test_run():
    res := geostrophic_u_43(9.8, 0.0001, 0.0002)
    diff := res - 842.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-geostrophic-wind-u-stage-43!")
