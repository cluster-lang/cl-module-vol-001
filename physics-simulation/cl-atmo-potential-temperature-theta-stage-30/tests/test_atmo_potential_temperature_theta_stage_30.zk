// cl-atmo-potential-temperature-theta-stage-30: Test Suite
import "../at_pt_30.zk"

fn test_run():
    res := theta_factor_30(300.0, 1.1)
    diff := res - 9257.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-30!")
