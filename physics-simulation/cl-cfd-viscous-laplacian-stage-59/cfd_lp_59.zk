// cl-cfd-viscous-laplacian-stage-59: CFD Viscous Laplacian Dissipation Stage 59
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn viscous_laplacian_59(up: float, uc: float, um: float) -> float:
    return (up - 2.0 * uc + um) * 59.0
