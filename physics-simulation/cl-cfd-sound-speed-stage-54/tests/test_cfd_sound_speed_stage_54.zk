// cl-cfd-sound-speed-stage-54: Test Suite
import "../cfd_ss_54.zk"

fn test_run():
    res := sound_speed_54(300.0)
    diff := res - 18768.8394
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
