// cl-astro-vis-viva-stage-100: Vis-Viva Orbital Velocity Component Stage 100
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vis_viva_component_100(r: float, a: float) -> float:
    return (2.0 / r - 1.0 / a) * 100.0
