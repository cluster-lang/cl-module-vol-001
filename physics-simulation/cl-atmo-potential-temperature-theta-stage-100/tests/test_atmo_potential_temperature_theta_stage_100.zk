// cl-atmo-potential-temperature-theta-stage-100: Test Suite
import "../at_pt_100.zk"

fn test_run():
    res := theta_factor_100(300.0, 1.1)
    diff := res - 30858.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-100!")
