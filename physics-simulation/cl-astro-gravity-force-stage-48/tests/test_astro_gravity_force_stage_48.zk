// cl-astro-gravity-force-stage-48: Test Suite
import "../grav_f_48.zk"

fn test_run():
    res := gravity_force_48(1000.0, 10.0, 10.0)
    diff := res - 4800.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-gravity-force-stage-48!")
