// cl-astro-vis-viva-energy-stage-70: Test Suite
import "../ast_se_70.zk"

fn test_run():
    res := specific_energy_70(398600.0, 7000.0)
    diff := res - -1993.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-vis-viva-energy-stage-70!")
