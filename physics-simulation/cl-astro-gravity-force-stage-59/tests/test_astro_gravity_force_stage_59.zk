// cl-astro-gravity-force-stage-59: Test Suite
import "../grav_f_59.zk"

fn test_run():
    res := gravity_force_59(1000.0, 10.0, 10.0)
    diff := res - 5900.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-gravity-force-stage-59!")
