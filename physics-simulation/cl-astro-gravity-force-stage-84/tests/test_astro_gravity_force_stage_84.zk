// cl-astro-gravity-force-stage-84: Test Suite
import "../grav_f_84.zk"

fn test_run():
    res := gravity_force_84(1000.0, 10.0, 10.0)
    diff := res - 8400.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-gravity-force-stage-84!")
