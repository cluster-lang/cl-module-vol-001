// cl-astro-escape-vel-sq-stage-96: Orbital Escape Velocity Squared Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn escape_vel_sq_96(mu: float, r: float) -> float:
    if r <= 0.0001: return 0.0
    return (2.0 * mu / r) * 96.0
