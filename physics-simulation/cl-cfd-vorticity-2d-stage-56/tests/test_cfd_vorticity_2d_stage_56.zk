// cl-cfd-vorticity-2d-stage-56: Test Suite
import "../cfd_vr_56.zk"

fn test_run():
    res := vorticity_2d_56(3.5, 1.2)
    diff := res - 128.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-vorticity-2d-stage-56!")
