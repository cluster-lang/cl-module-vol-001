// cl-astro-hyperbolic-excess-stage-36: Hyperbolic Excess Specific Energy Stage 36
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn hyperbolic_excess_36(v2: float, v_esc2: float) -> float:
    return 0.5 * (v2 - v_esc2) * 36.0
