// cl-atmo-hypsometric-thickness-stage-10: Test Suite
import "../at_hp_10.zk"

fn test_run():
    res := layer_thickness_10(287.05, 250.0, 9.80665, 0.6931)
    diff := res - 50719.2454
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
