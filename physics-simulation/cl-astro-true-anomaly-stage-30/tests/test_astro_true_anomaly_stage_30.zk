// cl-astro-true-anomaly-stage-30: Test Suite
import "../ast_ta_30.zk"

fn test_run():
    res := true_anomaly_scale_30(0.2)
    diff := res - 36.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-30!")
