// cl-astro-gravity-force-stage-67: Test Suite
import "../grav_f_67.zk"

fn test_run():
    res := gravity_force_67(1000.0, 10.0, 10.0)
    diff := res - 6700.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-gravity-force-stage-67!")
