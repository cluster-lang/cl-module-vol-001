// cl-cfd-sound-speed-stage-37: Test Suite
import "../cfd_ss_37.zk"

fn test_run():
    res := sound_speed_37(300.0)
    diff := res - 12860.1307
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
