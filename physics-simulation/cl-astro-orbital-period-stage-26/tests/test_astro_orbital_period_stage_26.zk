// cl-astro-orbital-period-stage-26: Test Suite
import "../ast_op_26.zk"

fn test_run():
    res := orbital_period_26(100.0)
    diff := res - 320.8400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-26!")
