// cl-astro-circ-speed-sq-stage-64: Test Suite
import "../circ_v2_64.zk"

fn test_run():
    res := circ_orbital_speed_sq_64(1000.0, 50.0)
    diff := res - 1280.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-circ-speed-sq-stage-64!")
