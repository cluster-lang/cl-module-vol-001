// cl-atmo-hypsometric-thickness-stage-19: Hypsometric Pressure Layer Geopotential Thickness Stage 19
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn layer_thickness_19(rd: float, t_avg: float, g0: float, log_p: float) -> float:
    return ((rd * t_avg / g0) * log_p) * 19.0
