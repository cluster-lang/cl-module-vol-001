// cl-astro-hyperbolic-excess-stage-55: Test Suite
import "../ast_he_55.zk"

fn test_run():
    res := hyperbolic_excess_55(150.0, 114.0)
    diff := res - 990.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-hyperbolic-excess-stage-55!")
