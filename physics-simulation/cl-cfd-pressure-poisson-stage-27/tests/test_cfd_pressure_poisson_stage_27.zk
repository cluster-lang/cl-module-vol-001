// cl-cfd-pressure-poisson-stage-27: Test Suite
import "../cfd_ps_27.zk"

fn test_run():
    res := pressure_source_27(1.225, 0.05)
    diff := res - 1.6538
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-pressure-poisson-stage-27!")
