// cl-astro-escape-vel-sq-stage-8: Test Suite
import "../esc_v2_8.zk"

fn test_run():
    res := escape_vel_sq_8(500.0, 10.0)
    diff := res - 800.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-escape-vel-sq-stage-8!")
