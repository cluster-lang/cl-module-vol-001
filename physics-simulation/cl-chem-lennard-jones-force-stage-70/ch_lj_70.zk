// cl-chem-lennard-jones-force-stage-70: Lennard-Jones Intermolecular Force Magnitude Stage 70
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lj_force_70(eps: float, sig: float, r: float) -> float:
    return (eps * sig / r) * 70.0
