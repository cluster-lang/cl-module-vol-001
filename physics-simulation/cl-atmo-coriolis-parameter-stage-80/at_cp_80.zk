// cl-atmo-coriolis-parameter-stage-80: Coriolis Earth Planetary Acceleration Parameter Stage 80
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn coriolis_param_80(omega: float, sin_lat: float) -> float:
    return (2.0 * omega * sin_lat) * 80.0
