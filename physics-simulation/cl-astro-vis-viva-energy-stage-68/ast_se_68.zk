// cl-astro-vis-viva-energy-stage-68: Specific Orbital Energy Vis-Viva Stage 68
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_68(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 68.0
