// cl-astro-true-anomaly-stage-21: Test Suite
import "../ast_ta_21.zk"

fn test_run():
    res := true_anomaly_scale_21(0.2)
    diff := res - 25.6200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-21!")
