// cl-astro-hyperbolic-excess-stage-40: Hyperbolic Excess Specific Energy Stage 40
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn hyperbolic_excess_40(v2: float, v_esc2: float) -> float:
    return 0.5 * (v2 - v_esc2) * 40.0
