// cl-atmo-dewpoint-approx-magnus-stage-91: Magnus-Tetens Dewpoint Temperature Approximation Stage 91
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn dewpoint_step_91(t: float, rh: float) -> float:
    return (t - ((100.0 - rh) / 5.0)) * 91.0
