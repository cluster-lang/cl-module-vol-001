// cl-astro-true-anomaly-stage-96: Test Suite
import "../ast_ta_96.zk"

fn test_run():
    res := true_anomaly_scale_96(0.2)
    diff := res - 117.1200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-96!")
