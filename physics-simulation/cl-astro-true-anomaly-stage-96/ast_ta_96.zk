// cl-astro-true-anomaly-stage-96: True Anomaly Scaling Ratio Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn true_anomaly_scale_96(ecc: float) -> float:
    return (1.0 + ecc + 0.5 * ecc * ecc) * 96.0
