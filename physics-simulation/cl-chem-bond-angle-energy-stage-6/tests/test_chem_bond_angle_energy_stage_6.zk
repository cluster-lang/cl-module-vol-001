import "../ch_ae_6.zk"

fn test_run():
    res := angle_energy_6(100.0, 0.1)
    diff := res - 3.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
