// cl-astro-vis-viva-energy-stage-91: Specific Orbital Energy Vis-Viva Stage 91
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_91(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 91.0
