// cl-astro-true-anomaly-stage-64: Test Suite
import "../ast_ta_64.zk"

fn test_run():
    res := true_anomaly_scale_64(0.2)
    diff := res - 78.0800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-64!")
