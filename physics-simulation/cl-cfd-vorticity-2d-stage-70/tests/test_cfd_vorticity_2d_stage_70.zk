// cl-cfd-vorticity-2d-stage-70: Test Suite
import "../cfd_vr_70.zk"

fn test_run():
    res := vorticity_2d_70(3.5, 1.2)
    diff := res - 161.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-vorticity-2d-stage-70!")
