// cl-cfd-sound-speed-stage-23: Test Suite
import "../cfd_ss_23.zk"

fn test_run():
    res := sound_speed_23(300.0)
    diff := res - 7994.1353
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-23!")
