// cl-atmo-hypsometric-thickness-stage-90: Test Suite
import "../at_hp_90.zk"

fn test_run():
    res := layer_thickness_90(287.05, 250.0, 9.80665, 0.6931)
    diff := res - 456473.2082
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-hypsometric-thickness-stage-90!")
