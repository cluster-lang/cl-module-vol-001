// cl-chem-morse-potential-stage-51: Test Suite
import "../ch_mp_51.zk"

fn test_run():
    res := morse_pot_51(5.0, 1.2, 0.1)
    diff := res - 224.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-morse-potential-stage-51!")
