// cl-cfd-vorticity-2d-stage-62: Test Suite
import "../cfd_vr_62.zk"

fn test_run():
    res := vorticity_2d_62(3.5, 1.2)
    diff := res - 142.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
