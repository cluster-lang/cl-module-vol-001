// cl-atmo-hypsometric-thickness-stage-4: Hypsometric Pressure Layer Geopotential Thickness Stage 4
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn layer_thickness_4(rd: float, t_avg: float, g0: float, log_p: float) -> float:
    return ((rd * t_avg / g0) * log_p) * 4.0
