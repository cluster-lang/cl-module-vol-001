// cl-chem-lennard-jones-force-stage-66: Lennard-Jones Intermolecular Force Magnitude Stage 66
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lj_force_66(eps: float, sig: float, r: float) -> float:
    return (eps * sig / r) * 66.0
