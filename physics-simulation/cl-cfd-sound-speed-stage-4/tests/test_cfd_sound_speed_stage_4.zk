// cl-cfd-sound-speed-stage-4: Test Suite
import "../cfd_ss_4.zk"

fn test_run():
    res := sound_speed_4(300.0)
    diff := res - 1390.2844
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-4!")
