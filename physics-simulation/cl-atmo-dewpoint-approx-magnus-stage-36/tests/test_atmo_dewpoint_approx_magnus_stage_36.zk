// cl-atmo-dewpoint-approx-magnus-stage-36: Test Suite
import "../at_dp_36.zk"

fn test_run():
    res := dewpoint_step_36(25.0, 80.0)
    diff := res - 756.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-dewpoint-approx-magnus-stage-36!")
