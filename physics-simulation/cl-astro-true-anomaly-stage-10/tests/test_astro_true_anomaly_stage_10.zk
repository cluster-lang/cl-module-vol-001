// cl-astro-true-anomaly-stage-10: Test Suite
import "../ast_ta_10.zk"

fn test_run():
    res := true_anomaly_scale_10(0.2)
    diff := res - 12.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-10!")
