// cl-atmo-coriolis-parameter-stage-91: Coriolis Earth Planetary Acceleration Parameter Stage 91
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn coriolis_param_91(omega: float, sin_lat: float) -> float:
    return (2.0 * omega * sin_lat) * 91.0
