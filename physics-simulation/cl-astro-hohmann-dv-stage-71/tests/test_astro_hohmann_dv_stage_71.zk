// cl-astro-hohmann-dv-stage-71: Test Suite
import "../hoh_dv_71.zk"

fn test_run():
    res := hohmann_factor_71(10.0, 30.0)
    diff := res - 106.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-hohmann-dv-stage-71!")
