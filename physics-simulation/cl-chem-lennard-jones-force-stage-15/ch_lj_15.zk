// cl-chem-lennard-jones-force-stage-15: Lennard-Jones Intermolecular Force Magnitude Stage 15
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lj_force_15(eps: float, sig: float, r: float) -> float:
    return (eps * sig / r) * 15.0
