// cl-astro-orbital-period-stage-81: Test Suite
import "../ast_op_81.zk"

fn test_run():
    res := orbital_period_81(100.0)
    diff := res - 999.5400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-81!")
