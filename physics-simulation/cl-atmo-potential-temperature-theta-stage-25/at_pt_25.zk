// cl-atmo-potential-temperature-theta-stage-25: Poisson Adiabatic Potential Temperature Factor Stage 25
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn theta_factor_25(temp: float, p_ratio: float) -> float:
    return (temp * (1.0 + 0.286 * (p_ratio - 1.0))) * 25.0
