import "../ch_ae_48.zk"

fn test_run():
    res := angle_energy_48(100.0, 0.1)
    diff := res - 24.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
