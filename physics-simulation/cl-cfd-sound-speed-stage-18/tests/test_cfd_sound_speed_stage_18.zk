// cl-cfd-sound-speed-stage-18: Test Suite
import "../cfd_ss_18.zk"

fn test_run():
    res := sound_speed_18(300.0)
    diff := res - 6256.2798
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-18!")
