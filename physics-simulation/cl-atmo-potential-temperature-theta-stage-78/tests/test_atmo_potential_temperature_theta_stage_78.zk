// cl-atmo-potential-temperature-theta-stage-78: Test Suite
import "../at_pt_78.zk"

fn test_run():
    res := theta_factor_78(300.0, 1.1)
    diff := res - 24069.2400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-78!")
