// cl-astro-vis-viva-energy-stage-98: Specific Orbital Energy Vis-Viva Stage 98
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_98(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 98.0
