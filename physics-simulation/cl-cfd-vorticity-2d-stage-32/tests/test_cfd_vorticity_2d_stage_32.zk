// cl-cfd-vorticity-2d-stage-32: Test Suite
import "../cfd_vr_32.zk"

fn test_run():
    res := vorticity_2d_32(3.5, 1.2)
    diff := res - 73.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-vorticity-2d-stage-32!")
