// cl-cfd-sound-speed-stage-55: Test Suite
import "../cfd_ss_55.zk"

fn test_run():
    res := sound_speed_55(300.0)
    diff := res - 19116.4105
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-55!")
