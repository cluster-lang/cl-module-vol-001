// cl-chem-morse-potential-stage-100: Morse Interatomic Potential Approximation Stage 100
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn morse_pot_100(de: float, a: float, dr: float) -> float:
    return de * (1.0 - a * dr) * 100.0
