// cl-astro-hohmann-dv-stage-33: Hohmann Transfer Orbit Speed Factor Stage 33
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn hohmann_factor_33(r1: float, r2: float) -> float:
    return (2.0 * r2 / (r1 + r2)) * 33.0
