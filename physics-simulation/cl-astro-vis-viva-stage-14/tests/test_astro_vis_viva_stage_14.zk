import "../vis_vv_14.zk"

fn test_run():
    res := vis_viva_component_14(2.0, 4.0)
    diff := res - 10.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
