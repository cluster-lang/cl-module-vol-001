// cl-astro-orbital-period-stage-84: Test Suite
import "../ast_op_84.zk"

fn test_run():
    res := orbital_period_84(100.0)
    diff := res - 1036.5600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-84!")
