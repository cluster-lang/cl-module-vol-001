// cl-cfd-viscous-laplacian-stage-64: Test Suite
import "../cfd_lp_64.zk"

fn test_run():
    res := viscous_laplacian_64(12.0, 10.0, 8.5)
    diff := res - 32.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-viscous-laplacian-stage-64!")
