// cl-astro-true-anomaly-stage-51: Test Suite
import "../ast_ta_51.zk"

fn test_run():
    res := true_anomaly_scale_51(0.2)
    diff := res - 62.2200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-51!")
