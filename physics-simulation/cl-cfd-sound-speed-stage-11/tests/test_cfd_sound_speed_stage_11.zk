// cl-cfd-sound-speed-stage-11: Test Suite
import "../cfd_ss_11.zk"

fn test_run():
    res := sound_speed_11(300.0)
    diff := res - 3823.2821
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-11!")
