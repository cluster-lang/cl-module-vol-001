// cl-cfd-sound-speed-stage-91: Test Suite
import "../cfd_ss_91.zk"

fn test_run():
    res := sound_speed_91(300.0)
    diff := res - 31628.9701
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-91!")
