// cl-astro-orbital-period-stage-60: Test Suite
import "../ast_op_60.zk"

fn test_run():
    res := orbital_period_60(100.0)
    diff := res - 740.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-60!")
