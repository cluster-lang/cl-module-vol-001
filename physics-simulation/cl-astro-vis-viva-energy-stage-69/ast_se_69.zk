// cl-astro-vis-viva-energy-stage-69: Specific Orbital Energy Vis-Viva Stage 69
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_69(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 69.0
