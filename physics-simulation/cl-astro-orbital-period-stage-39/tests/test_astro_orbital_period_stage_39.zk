// cl-astro-orbital-period-stage-39: Test Suite
import "../ast_op_39.zk"

fn test_run():
    res := orbital_period_39(100.0)
    diff := res - 481.2600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-39!")
