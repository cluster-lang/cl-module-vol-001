// cl-astro-orbital-period-stage-71: Test Suite
import "../ast_op_71.zk"

fn test_run():
    res := orbital_period_71(100.0)
    diff := res - 876.1400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-71!")
