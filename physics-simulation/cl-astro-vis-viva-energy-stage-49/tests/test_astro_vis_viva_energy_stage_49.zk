// cl-astro-vis-viva-energy-stage-49: Test Suite
import "../ast_se_49.zk"

fn test_run():
    res := specific_energy_49(398600.0, 7000.0)
    diff := res - -1395.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-vis-viva-energy-stage-49!")
