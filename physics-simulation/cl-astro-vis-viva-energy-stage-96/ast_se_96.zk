// cl-astro-vis-viva-energy-stage-96: Specific Orbital Energy Vis-Viva Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_96(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 96.0
