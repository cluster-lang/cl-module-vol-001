// cl-atmo-dewpoint-approx-magnus-stage-69: Test Suite
import "../at_dp_69.zk"

fn test_run():
    res := dewpoint_step_69(25.0, 80.0)
    diff := res - 1449.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
