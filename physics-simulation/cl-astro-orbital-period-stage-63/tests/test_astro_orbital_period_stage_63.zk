// cl-astro-orbital-period-stage-63: Test Suite
import "../ast_op_63.zk"

fn test_run():
    res := orbital_period_63(100.0)
    diff := res - 777.4200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-63!")
