import "../ch_ae_19.zk"

fn test_run():
    res := angle_energy_19(100.0, 0.1)
    diff := res - 9.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-bond-angle-energy-stage-19!")
