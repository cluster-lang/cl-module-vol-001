// cl-astro-vis-viva-stage-12: Test Suite
import "../vis_vv_12.zk"

fn test_run():
    res := vis_viva_component_12(2.0, 4.0)
    diff := res - 9.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-vis-viva-stage-12!")
