// cl-atmo-coriolis-parameter-stage-58: Coriolis Earth Planetary Acceleration Parameter Stage 58
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn coriolis_param_58(omega: float, sin_lat: float) -> float:
    return (2.0 * omega * sin_lat) * 58.0
