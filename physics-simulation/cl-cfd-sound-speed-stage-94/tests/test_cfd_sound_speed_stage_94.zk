// cl-cfd-sound-speed-stage-94: Test Suite
import "../cfd_ss_94.zk"

fn test_run():
    res := sound_speed_94(300.0)
    diff := res - 32671.6834
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-94!")
