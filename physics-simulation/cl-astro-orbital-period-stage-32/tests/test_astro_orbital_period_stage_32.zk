// cl-astro-orbital-period-stage-32: Test Suite
import "../ast_op_32.zk"

fn test_run():
    res := orbital_period_32(100.0)
    diff := res - 394.8800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-orbital-period-stage-32!")
