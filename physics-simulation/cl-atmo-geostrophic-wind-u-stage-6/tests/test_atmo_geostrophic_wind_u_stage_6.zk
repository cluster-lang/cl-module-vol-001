// cl-atmo-geostrophic-wind-u-stage-6: Test Suite
import "../at_gw_6.zk"

fn test_run():
    res := geostrophic_u_6(9.8, 0.0001, 0.0002)
    diff := res - 117.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-geostrophic-wind-u-stage-6!")
