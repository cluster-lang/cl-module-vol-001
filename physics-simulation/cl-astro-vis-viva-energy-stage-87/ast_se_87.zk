// cl-astro-vis-viva-energy-stage-87: Specific Orbital Energy Vis-Viva Stage 87
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn specific_energy_87(mu: float, a: float) -> float:
    return (-mu / (2.0 * a)) * 87.0
