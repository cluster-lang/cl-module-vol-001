// cl-chem-morse-potential-stage-42: Test Suite
import "../ch_mp_42.zk"

fn test_run():
    res := morse_pot_42(5.0, 1.2, 0.1)
    diff := res - 184.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-morse-potential-stage-42!")
