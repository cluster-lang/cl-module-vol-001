// cl-atmo-potential-temperature-theta-stage-41: Test Suite
import "../at_pt_41.zk"

fn test_run():
    res := theta_factor_41(300.0, 1.1)
    diff := res - 12651.7800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-41!")
