// cl-cfd-viscous-laplacian-stage-57: CFD Viscous Laplacian Dissipation Stage 57
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn viscous_laplacian_57(up: float, uc: float, um: float) -> float:
    return (up - 2.0 * uc + um) * 57.0
