// cl-atmo-coriolis-parameter-stage-64: Test Suite
import "../at_cp_64.zk"

fn test_run():
    res := coriolis_param_64(0.00007292, 0.7071)
    diff := res - 0.0066
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-coriolis-parameter-stage-64!")
