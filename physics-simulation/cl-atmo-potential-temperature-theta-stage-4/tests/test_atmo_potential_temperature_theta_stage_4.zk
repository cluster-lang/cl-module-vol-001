// cl-atmo-potential-temperature-theta-stage-4: Test Suite
import "../at_pt_4.zk"

fn test_run():
    res := theta_factor_4(300.0, 1.1)
    diff := res - 1234.3200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-4!")
