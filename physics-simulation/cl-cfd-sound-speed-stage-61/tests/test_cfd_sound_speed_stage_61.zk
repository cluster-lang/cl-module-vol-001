// cl-cfd-sound-speed-stage-61: Test Suite
import "../cfd_ss_61.zk"

fn test_run():
    res := sound_speed_61(300.0)
    diff := res - 21201.8371
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cfd-sound-speed-stage-61!")
