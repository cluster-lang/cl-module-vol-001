// cl-cfd-vorticity-2d-stage-31: Test Suite
import "../cfd_vr_31.zk"

fn test_run():
    res := vorticity_2d_31(3.5, 1.2)
    diff := res - 71.3000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
