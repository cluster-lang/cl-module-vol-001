// cl-astro-gravity-force-stage-96: Test Suite
import "../grav_f_96.zk"

fn test_run():
    res := gravity_force_96(1000.0, 10.0, 10.0)
    diff := res - 9600.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-gravity-force-stage-96!")
