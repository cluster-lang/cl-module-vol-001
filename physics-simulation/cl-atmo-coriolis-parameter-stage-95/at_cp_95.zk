// cl-atmo-coriolis-parameter-stage-95: Coriolis Earth Planetary Acceleration Parameter Stage 95
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn coriolis_param_95(omega: float, sin_lat: float) -> float:
    return (2.0 * omega * sin_lat) * 95.0
