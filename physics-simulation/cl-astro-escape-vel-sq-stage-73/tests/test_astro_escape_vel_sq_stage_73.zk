import "../esc_v2_73.zk"

fn test_run():
    res := escape_vel_sq_73(500.0, 10.0)
    diff := res - 7300.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
