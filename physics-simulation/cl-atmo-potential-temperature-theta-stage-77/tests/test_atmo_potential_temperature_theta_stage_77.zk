// cl-atmo-potential-temperature-theta-stage-77: Test Suite
import "../at_pt_77.zk"

fn test_run():
    res := theta_factor_77(300.0, 1.1)
    diff := res - 23760.6600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-77!")
