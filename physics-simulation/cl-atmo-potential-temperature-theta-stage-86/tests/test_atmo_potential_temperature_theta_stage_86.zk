// cl-atmo-potential-temperature-theta-stage-86: Test Suite
import "../at_pt_86.zk"

fn test_run():
    res := theta_factor_86(300.0, 1.1)
    diff := res - 26537.8800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-potential-temperature-theta-stage-86!")
