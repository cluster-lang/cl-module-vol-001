// cl-cfd-sound-speed-stage-59: Test Suite
import "../cfd_ss_59.zk"

fn test_run():
    res := sound_speed_59(300.0)
    diff := res - 20506.6949
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
