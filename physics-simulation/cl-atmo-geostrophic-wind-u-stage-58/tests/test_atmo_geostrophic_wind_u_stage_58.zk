// cl-atmo-geostrophic-wind-u-stage-58: Test Suite
import "../at_gw_58.zk"

fn test_run():
    res := geostrophic_u_58(9.8, 0.0001, 0.0002)
    diff := res - 1136.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-atmo-geostrophic-wind-u-stage-58!")
