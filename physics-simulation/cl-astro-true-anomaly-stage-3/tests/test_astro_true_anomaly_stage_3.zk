// cl-astro-true-anomaly-stage-3: Test Suite
import "../ast_ta_3.zk"

fn test_run():
    res := true_anomaly_scale_3(0.2)
    diff := res - 3.6600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-astro-true-anomaly-stage-3!")
