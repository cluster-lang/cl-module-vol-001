// cl-chem-covalent-bond-energy-stage-48: Test Suite
import "../ch_be_48.zk"

fn test_run():
    res := bond_energy_48(300.0, 0.05)
    diff := res - 18.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-chem-covalent-bond-energy-stage-48!")
