// Basis derivatives for uniform quadratic B-spline
fn bspline_quad_d0(t: float) -> float:
    return t - 1.0

fn bspline_quad_d1(t: float) -> float:
    return 1.0 - (2.0 * t)

fn bspline_quad_d2(t: float) -> float:
    return t
