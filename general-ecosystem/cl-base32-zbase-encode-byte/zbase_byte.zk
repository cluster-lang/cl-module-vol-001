// cl-base32-zbase-encode-byte: Single 5-bit Symbol z-base-32 Encoder
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn zbase_encode_5bit(val: int) -> int:
    v := val & 31
    if v == 0:  return 121
    if v == 1:  return 98
    if v == 2:  return 110
    if v == 3:  return 100
    if v == 4:  return 114
    if v == 5:  return 102
    if v == 6:  return 103
    if v == 7:  return 56
    if v == 8:  return 101
    if v == 9:  return 106
    if v == 10: return 107
    if v == 11: return 109
    if v == 12: return 99
    if v == 13: return 112
    if v == 14: return 113
    if v == 15: return 120
    if v == 16: return 111
    if v == 17: return 116
    if v == 18: return 49
    if v == 19: return 117
    if v == 20: return 119
    if v == 21: return 105
    if v == 22: return 115
    if v == 23: return 122
    if v == 24: return 97
    if v == 25: return 51
    if v == 26: return 52
    if v == 27: return 53
    if v == 28: return 104
    if v == 29: return 55
    if v == 30: return 54
    if v == 31: return 57
    return 63
