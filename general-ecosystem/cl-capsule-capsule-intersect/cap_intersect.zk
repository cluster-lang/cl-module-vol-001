// cl-capsule-capsule-intersect: 3D Segment Distance Bound
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn capsules_intersect(c1x: float, c1y: float, c1z: float, r1: float, c2x: float, c2y: float, c2z: float, r2: float) -> int:
    dx := c2x - c1x
    dy := c2y - c1y
    dz := c2z - c1z
    d_sq := (dx * dx) + (dy * dy) + (dz * dz)
    r_sum := r1 + r2
    if d_sq <= (r_sum * r_sum): return 1
    return 0
