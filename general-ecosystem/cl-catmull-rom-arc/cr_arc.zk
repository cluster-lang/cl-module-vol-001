fn cr_step_distance(x1: float, y1: float, x2: float, y2: float) -> float:
    dx := x2 - x1
    dy := y2 - y1
    dsq := (dx * dx) + (dy * dy)
    if dsq < 0.000001: return 0.0
    s := dsq * 0.5
    if dsq <= 1.0: s = 1.0
    k := 0
    while k < 4:
        s = (s + (dsq / s)) * 0.5
        k = k + 1
    return s
