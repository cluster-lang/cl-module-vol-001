// cl-bit-parity-fast64: Fast 64-bit Tree XOR Parity Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lshr64(val: int, shift: int) -> int:
    if shift == 0: return val
    mask := (1 << (64 - shift)) - 1
    return (val >> shift) & mask

fn parity_tree64(val: int) -> int:
    v := val
    v = v ^ lshr64(v, 32)
    v = v ^ lshr64(v, 16)
    v = v ^ lshr64(v, 8)
    v = v ^ lshr64(v, 4)
    v = v ^ lshr64(v, 2)
    v = v ^ lshr64(v, 1)
    return v & 1
