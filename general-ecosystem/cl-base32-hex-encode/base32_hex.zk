// cl-base32-hex-encode: RFC 4648 Base32hex Character Lookup Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn base32hex_encode_char(val: int) -> int:
    v := val & 31
    if v < 10:
        return 48 + v
    return 65 + (v - 10)
