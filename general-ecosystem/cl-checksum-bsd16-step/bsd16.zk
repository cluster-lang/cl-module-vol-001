// cl-checksum-bsd16-step: BSD 16-Bit Checksum Accumulator Step
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bsd16_step(chk: int, b: int) -> int:
    rot := ((chk >> 1) | ((chk & 1) << 15)) & 65535
    return (rot + (b & 255)) & 65535
