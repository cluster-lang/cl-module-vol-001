// cl-bit-parity64: Test Suite
import "../parity.zk"

fn test_parity():
    // 0 has 0 bits (even parity -> 0)
    if bit_parity64(0) != 0: sys_exit(1)
    // 1 has 1 bit (odd parity -> 1)
    if bit_parity64(1) != 1: sys_exit(1)
    // 3 (0b11) has 2 bits (even parity -> 0)
    if bit_parity64(3) != 0: sys_exit(1)
    // 7 (0b111) has 3 bits (odd parity -> 1)
    if bit_parity64(7) != 1: sys_exit(1)
    print("test_parity passed: 64-bit bit parity verified")

fn main():
    test_parity()
    print("✓ All tests passed for cl-bit-parity64!")
