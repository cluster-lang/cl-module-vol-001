// cl-aero-lift-force-stage-30: Test Suite
import "../lift_f_30.zk"

fn test_run():
    res := lift_force_30(100.0, 2.0, 0.5)
    diff := res - 3000.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-lift-force-stage-30!")
