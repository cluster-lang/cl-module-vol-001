// cl-aero-drag-force-stage-11: Test Suite
import "../drag_f_11.zk"

fn test_run():
    res := drag_force_11(100.0, 2.0, 0.02)
    diff := res - 44.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-drag-force-stage-11!")
