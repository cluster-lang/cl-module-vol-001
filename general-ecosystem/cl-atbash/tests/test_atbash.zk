// cl-atbash: Test Suite
import "../atbash.zk"

fn test_atbash():
    input := "ABCxyz!"
    res := atbash(input)
    if res != "ZYXcba!":
        print("Atbash mismatch! Expected ZYXcba!, Got: " + res)
        sys_exit(1)
    roundtrip := atbash(res)
    if roundtrip != input:
        print("Atbash roundtrip mismatch! Got: " + roundtrip)
        sys_exit(1)
    print("test_atbash passed: verified")

fn main():
    test_atbash()
    print("✓ All tests passed for cl-atbash!")
