// cl-bspline-uniform-basis-quadratic: Test Suite
import "../bs_quad.zk"

fn test_bs_quad():
    b: vector[float] := [0.0, 0.0, 0.0]
    bspline_quadratic_basis(0.5, b)
    // At u=0.5: b0=0.125, b1=0.75, b2=0.125
    sum := b[0] + b[1] + b[2]
    diff := sum - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_bs_quad passed")

fn main():
    test_bs_quad()
    print("✓ All tests passed for cl-bspline-uniform-basis-quadratic!")
