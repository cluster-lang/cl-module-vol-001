// cl-base32-crockford-norm: Crockford Base32 Character Normalizer
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn crockford_normalize_char(c: int) -> int:
    // 'i' or 'I' or 'l' or 'L' -> '1' (49)
    if c == 73: return 49
    if c == 105: return 49
    if c == 76: return 49
    if c == 108: return 49
    // 'o' or 'O' -> '0' (48)
    if c == 79: return 48
    if c == 111: return 48
    return c
