// Degree p, n control points: m = n + p + 1 knots
fn generate_clamped_knots(out: vector[float], n: int, p: int):
    i := 0
    while i <= p:
        out.push(0.0)
        i = i + 1
    internal := n - p - 1
    j := 1
    while j <= internal:
        out.push((j * 1.0) / ((internal + 1) * 1.0))
        j = j + 1
    k := 0
    while k <= p:
        out.push(1.0)
        k = k + 1
