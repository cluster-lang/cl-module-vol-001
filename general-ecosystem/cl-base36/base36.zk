// cl-base36: Pure Cluster Base36 Alphanumeric Codec
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn b36_char(v: int) -> string:
    if v < 10: return chr(v + 48)
    return chr(v - 10 + 97)

fn base36_encode(n: int) -> string:
    if n == 0: return "0"
    res := ""
    val := n
    while val > 0:
        rem := val % 36
        res = b36_char(rem) + res
        val = val / 36
    return res
