// cl-bit-count-trailing-zeros-fast: Fast 64-bit Trailing Zeros Counter
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn count_trailing_zeros64(val: int) -> int:
    if val == 0: return 64
    count := 0
    v := val
    while (v & 1) == 0 and count < 64:
        count = count + 1
        v = v >> 1
    return count
