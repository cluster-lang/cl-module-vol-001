// cl-aero-lift-force-stage-42: Test Suite
import "../lift_f_42.zk"

fn test_run():
    res := lift_force_42(100.0, 2.0, 0.5)
    diff := res - 4200.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-lift-force-stage-42!")
