// cl-catmull-rom-eval-point: Catmull-Rom 4-Point Spline Interpolator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn catmull_rom_eval(p0: float, p1: float, p2: float, p3: float, t: float) -> float:
    t2 := t * t
    t3 := t2 * t
    term0 := 0.0 - p0 + 3.0 * p1 - 3.0 * p2 + p3
    term1 := 2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3
    term2 := 0.0 - p0 + p2
    term3 := 2.0 * p1
    return 0.5 * (term0 * t3 + term1 * t2 + term2 * t + term3)
