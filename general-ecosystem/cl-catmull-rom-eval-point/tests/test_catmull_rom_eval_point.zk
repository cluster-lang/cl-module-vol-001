// cl-catmull-rom-eval-point: Test Suite
import "../catmull_pt.zk"

fn test_catmull_pt():
    // At t=0, spline passes through p1
    v0 := catmull_rom_eval(0.0, 10.0, 20.0, 30.0, 0.0)
    diff0 := v0 - 10.0
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    // At t=1, spline passes through p2
    v1 := catmull_rom_eval(0.0, 10.0, 20.0, 30.0, 1.0)
    diff1 := v1 - 20.0
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    print("test_catmull_pt passed: Catmull-Rom endpoints verified")

fn main():
    test_catmull_pt()
    print("✓ All tests passed for cl-catmull-rom-eval-point!")
