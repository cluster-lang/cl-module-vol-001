// cl-bloom-filter-intersection: Test Suite
import "../bloom_inter.zk"

fn test_bloom_inter():
    f1: vector[int] := [3, 6]
    f2: vector[int] := [5, 4]
    out: vector[int] := []
    bloom_intersection(out, f1, f2)
    if out[0] != 1: sys_exit(1) // 3 & 5 = 1
    if out[1] != 4: sys_exit(1) // 6 & 4 = 4
    print("test_bloom_inter passed: bitwise intersection verified")

fn main():
    test_bloom_inter()
    print("✓ All tests passed for cl-bloom-filter-intersection!")
