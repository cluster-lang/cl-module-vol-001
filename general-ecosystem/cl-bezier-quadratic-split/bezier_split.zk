// Splits quadratic curve at t=0.5: writes left curve [l0, l1, l2] and right [r0, r1, r2]
fn bezier_quad_split_half(out_left: vector[float], out_right: vector[float], p0: float, p1: float, p2: float):
    q0 := (p0 + p1) * 0.5
    q1 := (p1 + p2) * 0.5
    r := (q0 + q1) * 0.5
    out_left.push(p0)
    out_left.push(q0)
    out_left.push(r)
    out_right.push(r)
    out_right.push(q1)
    out_right.push(p2)
