fn nibble_to_hex(n: int) -> string:
    v := n & 15
    if v < 10: return chr(v + 48)
    return chr(v - 10 + 97)

fn hex_to_nibble(c: int) -> int:
    if c >= 48 and c <= 57: return c - 48
    if c >= 97 and c <= 102: return c - 97 + 10
    if c >= 65 and c <= 70: return c - 65 + 10
    return 0

fn base16_encode(bytes: vector[int]) -> string:
    res := ""
    i := 0
    blen := bytes.len()
    while i < blen:
        b := bytes[i] & 255
        res = res + nibble_to_hex((b >> 4) & 15) + nibble_to_hex(b & 15)
        i = i + 1
    return res

fn base16_decode(hex_str: string) -> vector[int]:
    res: vector[int] := []
    slen := len(hex_str)
    i := 0
    while (i + 1) < slen:
        hi := hex_to_nibble(byte_at(hex_str, i))
        lo := hex_to_nibble(byte_at(hex_str, i + 1))
        res.push((hi << 4) | lo)
        i = i + 2
    return res
