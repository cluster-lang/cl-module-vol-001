fn caesar_encrypt(s: string, shift: int) -> string:
    res := ""
    sh := ((shift % 26) + 26) % 26
    i := 0
    slen := len(s)
    while i < slen:
        b := byte_at(s, i)
        if b >= 65 and b <= 90:
            res = res + chr(((b - 65 + sh) % 26) + 65)
        elif b >= 97 and b <= 122:
            res = res + chr(((b - 97 + sh) % 26) + 97)
        else:
            res = res + chr(b)
        i = i + 1
    return res

fn caesar_decrypt(s: string, shift: int) -> string:
    return caesar_encrypt(s, 0 - shift)
