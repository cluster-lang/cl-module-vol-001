// cl-bit-swap-bytes64: 64-bit Integer Endianness Byte Swap
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bit_swap_bytes64(val: int) -> int:
    mask64 := 9223372036854775807
    v := val & mask64
    b0 := v & 255
    b1 := (v >> 8) & 255
    b2 := (v >> 16) & 255
    b3 := (v >> 24) & 255
    b4 := (v >> 32) & 255
    b5 := (v >> 40) & 255
    b6 := (v >> 48) & 255
    b7 := (v >> 56) & 255
    res := (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
    return res & mask64
