// cl-aero-dynamic-pressure-stage-1: Test Suite
import "../dyn_pr_1.zk"

fn test_run():
    res := dynamic_pressure_1(1.225, 10.0)
    diff := res - 61.2500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-dynamic-pressure-stage-1!")
