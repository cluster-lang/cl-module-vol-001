// cl-bit-clear-bit-index: Clear Bit at Specified Index [0, 31]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn clear_bit_at(val: int, bit_index: int) -> int:
    if bit_index < 0 or bit_index > 31: return val
    mask := 4294967295 ^ (1 << bit_index)
    return val & mask
