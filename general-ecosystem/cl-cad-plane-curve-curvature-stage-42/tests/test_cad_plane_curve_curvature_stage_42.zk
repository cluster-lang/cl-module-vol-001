// cl-cad-plane-curve-curvature-stage-42: Test Suite
import "../crv_k_42.zk"

fn test_run():
    res := curve_curvature_num_42(2.0, 3.0, 1.0, 4.0)
    diff := res - 84.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
