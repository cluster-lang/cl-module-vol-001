// cl-bit-count-leading-zeros: Test Suite
import "../clz.zk"

fn test_clz():
    if count_leading_zeros(0) != 64: sys_exit(1)
    // 1 has 63 leading zeros
    if count_leading_zeros(1) != 63: sys_exit(1)
    // -1 has MSB set -> 0 leading zeros
    if count_leading_zeros(-1) != 0: sys_exit(1)
    print("test_clz passed: 64-bit leading zero count verified")

fn main():
    test_clz()
    print("✓ All tests passed for cl-bit-count-leading-zeros!")
