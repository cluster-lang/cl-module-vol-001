// cl-catmull-rom-chordal-eval: Test Suite
import "../catmull_chord_eval.zk"

fn test_catmull_chord_eval():
    mid := catmull_rom_midpoint(10.0, 30.0)
    diff := mid - 20.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_catmull_chord_eval passed: chordal midpoint verified")

fn main():
    test_catmull_chord_eval()
    print("✓ All tests passed for cl-catmull-rom-chordal-eval!")
