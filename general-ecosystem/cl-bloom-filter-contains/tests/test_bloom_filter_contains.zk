// cl-bloom-filter-contains: Test Suite
import "../bloom_contains.zk"

fn test_bloom_contains():
    filt := (1 << 5) | (1 << 12)
    hit := bloom_check_double(filt, 5, 12)
    if hit != 1: sys_exit(1)
    miss := bloom_check_double(filt, 5, 13)
    if miss != 0: sys_exit(1)
    print("test_bloom_contains passed: bloom filter query verified")

fn main():
    test_bloom_contains()
    print("✓ All tests passed for cl-bloom-filter-contains!")
