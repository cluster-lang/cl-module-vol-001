fn bezier_quad_aabb1d(p0: float, p1: float, p2: float, out: vector[float]):
    min_v := p0
    if p2 < min_v: min_v = p2
    max_v := p0
    if p2 > max_v: max_v = p2
    denom := p0 - 2.0 * p1 + p2
    if denom != 0.0:
        t := (p0 - p1) / denom
        if t > 0.0:
            if t < 1.0:
                omt := 1.0 - t
                extrema := omt * omt * p0 + 2.0 * omt * t * p1 + t * t * p2
                if extrema < min_v: min_v = extrema
                if extrema > max_v: max_v = extrema
    out.push(min_v)
    out.push(max_v)
