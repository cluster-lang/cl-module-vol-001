// cl-bezier-quadratic-bounding: Test Suite
import "../bezier_bbox.zk"

fn test_bezier_bbox():
    out: vector[float] := []
    bezier_quad_aabb1d(0.0, 10.0, 0.0, out)
    if out[0] != 0.0: sys_exit(1)
    diff := out[1] - 5.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_bezier_bbox passed: quadratic Bezier AABB verified")

fn main():
    test_bezier_bbox()
    print("✓ All tests passed for cl-bezier-quadratic-bounding!")
