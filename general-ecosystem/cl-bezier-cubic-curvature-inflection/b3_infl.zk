// cl-bezier-cubic-curvature-inflection: Cubic Bezier Curvature Inflection Test
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bezier_derivs_cross(p0: vector[float], p1: vector[float], p2: vector[float], p3: vector[float], t: float) -> float:
    omt := 1.0 - t
    // First derivative B'(t) = 3*(1-t)^2*(p1-p0) + 6*(1-t)*t*(p2-p1) + 3*t^2*(p3-p2)
    c0 := 3.0 * omt * omt
    c1 := 6.0 * omt * t
    c2 := 3.0 * t * t
    vx := c0 * (p1[0] - p0[0]) + c1 * (p2[0] - p1[0]) + c2 * (p3[0] - p2[0])
    vy := c0 * (p1[1] - p0[1]) + c1 * (p2[1] - p1[1]) + c2 * (p3[1] - p2[1])

    // Second derivative B''(t) = 6*(1-t)*(p2 - 2p1 + p0) + 6*t*(p3 - 2p2 + p1)
    d0 := 6.0 * omt
    d1 := 6.0 * t
    ax := d0 * (p2[0] - 2.0*p1[0] + p0[0]) + d1 * (p3[0] - 2.0*p2[0] + p1[0])
    ay := d0 * (p2[1] - 2.0*p1[1] + p0[1]) + d1 * (p3[1] - 2.0*p2[1] + p1[1])

    return vx * ay - vy * ax

fn bezier_has_inflection(p0: vector[float], p1: vector[float], p2: vector[float], p3: vector[float]) -> int:
    k_start := bezier_derivs_cross(p0, p1, p2, p3, 0.1)
    k_end := bezier_derivs_cross(p0, p1, p2, p3, 0.9)
    if (k_start > 0.0 and k_end < 0.0) or (k_start < 0.0 and k_end > 0.0):
        return 1
    return 0
