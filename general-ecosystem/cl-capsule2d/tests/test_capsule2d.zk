// cl-capsule2d: Test Suite
import "../capsule2d.zk"

fn test_capsule2d():
    // Capsule segment from (0,0) to (10,0), radius 2
    if capsule2d_contains(0, 0, 10, 0, 2, 5, 1) != 1: sys_exit(1)
    if capsule2d_contains(0, 0, 10, 0, 2, 5, 3) != 0: sys_exit(1)
    print("test_capsule2d passed: 2D capsule containment verified")

fn main():
    test_capsule2d()
    print("✓ All tests passed for cl-capsule2d!")
