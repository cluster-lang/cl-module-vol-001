fn clamp2(val: int, lo: int, hi: int) -> int:
    if val < lo: return lo
    if val > hi: return hi
    return val

fn capsule2d_contains(ax: int, ay: int, bx: int, by: int, radius: int, px: int, py: int) -> int:
    abx := bx - ax
    aby := by - ay
    apx := px - ax
    apy := py - ay

    ab_len_sq := (abx * abx) + (aby * aby)
    if ab_len_sq == 0:
        dsq := (apx * apx) + (apy * apy)
        if dsq <= (radius * radius): return 1
        return 0

    dot := (apx * abx) + (apy * aby)
    t_scaled := clamp2((dot * 1000) / ab_len_sq, 0, 1000)

    cx := ax + ((t_scaled * abx) / 1000)
    cy := ay + ((t_scaled * aby) / 1000)

    dx := px - cx
    dy := py - cy
    if ((dx * dx) + (dy * dy)) <= (radius * radius): return 1
    return 0
