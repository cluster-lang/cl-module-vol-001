// cl-bvh-leaf-morton3d-interleave: 3D 10-bit Morton Code Interleaver
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn expand_bits10(val: int) -> int:
    v := val & 1023
    v = (v ^ (v << 16)) & 4278190335
    v = (v ^ (v << 8)) & 251719695
    v = (v ^ (v << 4)) & 3272356035
    v = (v ^ (v << 2)) & 1227133513
    return v

fn morton3d_interleave(x: int, y: int, z: int) -> int:
    return (expand_bits10(x) << 2) | (expand_bits10(y) << 1) | expand_bits10(z)
