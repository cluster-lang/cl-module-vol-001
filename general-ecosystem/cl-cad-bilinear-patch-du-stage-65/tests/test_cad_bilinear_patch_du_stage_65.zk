import "../cad_du_65.zk"

fn test_run():
    res := patch_du_65(1.0, 5.0)
    diff := res - 260.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
