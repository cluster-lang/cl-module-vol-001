fn cr_eval_1d(p0: float, p1: float, p2: float, p3: float, t: float) -> float:
    t2 := t * t
    t3 := t2 * t
    a0 := -0.5*t3 + t2 - 0.5*t
    a1 := 1.5*t3 - 2.5*t2 + 1.0
    a2 := -1.5*t3 + 2.0*t2 + 0.5*t
    a3 := 0.5*t3 - 0.5*t2
    return (a0 * p0) + (a1 * p1) + (a2 * p2) + (a3 * p3)

fn cr_eval_2d(out: vector[float], x0: float, y0: float, x1: float, y1: float, x2: float, y2: float, x3: float, y3: float, t: float):
    out.push(cr_eval_1d(x0, x1, x2, x3, t))
    out.push(cr_eval_1d(y0, y1, y2, y3, t))
