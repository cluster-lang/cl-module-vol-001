// cl-bvh-leaf-morton3d-coords: Normalized Point to Morton Code Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn quantize_coord(c: float, min_c: float, max_c: float) -> int:
    span := max_c - min_c
    if span <= 0.000001: return 0
    norm := (c - min_c) / span
    if norm < 0.0: norm = 0.0
    if norm > 1.0: norm = 1.0
    val := int(norm * 1023.0)
    return val & 1023
