// cl-char-is-alpha: Check If ASCII Value Is Alphabetic [a-zA-Z]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn char_is_alpha(c: int) -> int:
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122): return 1
    return 0
