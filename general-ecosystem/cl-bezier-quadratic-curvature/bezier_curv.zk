fn sqrt_approx(val: float) -> float:
    if val <= 0.0: return 0.0
    s := val * 0.5
    if s < 1.0: s = 1.0
    iter := 0
    while iter < 6:
        s = (s + val / s) * 0.5
        iter = iter + 1
    return s

fn bezier_quad_curvature(dx: float, dy: float, ddx: float, ddy: float) -> float:
    // kappa = |x' y'' - y' x''| / (x'^2 + y'^2)^(3/2)
    cross := dx * ddy - dy * ddx
    if cross < 0.0: cross = 0.0 - cross
    speed_sq := dx * dx + dy * dy
    if speed_sq < 0.000001: return 0.0
    speed := sqrt_approx(speed_sq)
    denom := speed * speed_sq
    return cross / denom
