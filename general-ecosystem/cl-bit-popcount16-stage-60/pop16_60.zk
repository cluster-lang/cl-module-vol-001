// cl-bit-popcount16-stage-60: 16-bit Population Count Stage 60
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn popcount16_60(x: int) -> int:
    cnt := 0
    t := x & 65535
    while t > 0:
        cnt = cnt + (t & 1)
        t = t >> 1
    return cnt
