// cl-bspline-clamped-basis: Test Suite
import "../bspline_basis.zk"

fn test_bspline_basis():
    b := bspline_linear_basis(0.5, 0.0, 1.0, 2.0)
    diff := b - 0.5
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_bspline_basis passed: linear basis 0.5 verified")

fn main():
    test_bspline_basis()
    print("✓ All tests passed for cl-bspline-clamped-basis!")
