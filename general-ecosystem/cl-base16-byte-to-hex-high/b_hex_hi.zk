// cl-base16-byte-to-hex-high: Byte High Nibble to Hex ASCII
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn byte_to_hex_high(b: int) -> int:
    val := (b >> 4) & 15
    if val < 10: return 48 + val
    return 97 + (val - 10)
