// cl-bspline-clamped-basis-eval: Uniform Clamped B-Spline Basis Weight Evaluator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bspline_quadratic_weights(t: float) -> vector[float]:
    w0 := 0.5 * (1.0 - t) * (1.0 - t)
    w1 := 0.5 + t * (1.0 - t)
    w2 := 0.5 * t * t
    res: vector[float] := [w0, w1, w2]
    return res
