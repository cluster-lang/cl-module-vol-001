fn aabb3d_overlap(min_a: vector[float], max_a: vector[float], min_b: vector[float], max_b: vector[float]) -> int:
    i := 0
    while i < 3:
        if max_a[i] < min_b[i]: return 0
        if min_a[i] > max_b[i]: return 0
        i = i + 1
    return 1
