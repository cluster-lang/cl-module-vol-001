// cl-cad-bezier-weight-norm-stage-22: Rational Bezier Basis Weight Normalizer Stage 22
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bezier_weight_norm_22(w0: float, w1: float, b0: float, b1: float) -> float:
    return (w0*b0 + w1*b1) * 22.0
