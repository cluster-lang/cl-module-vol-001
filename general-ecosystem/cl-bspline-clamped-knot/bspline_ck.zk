// Returns 1 if first (degree+1) knots are identical (clamped start)
fn is_clamped_start(knots: vector[float], degree: int) -> int:
    val := knots[0]
    i := 1
    while i <= degree:
        if knots[i] != val: return 0
        i = i + 1
    return 1
