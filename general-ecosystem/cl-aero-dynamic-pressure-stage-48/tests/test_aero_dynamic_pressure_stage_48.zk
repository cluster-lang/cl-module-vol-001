import "../dyn_pr_48.zk"

fn test_run():
    res := dynamic_pressure_48(1.225, 10.0)
    diff := res - 2940.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
