fn merge_hull_chains(out: vector[int], lower: vector[int], upper: vector[int]):
    n_low := lower.len() / 2
    n_up := upper.len() / 2
    i := 0
    while i < (n_low - 1):
        out.push(lower[i * 2])
        out.push(lower[(i * 2) + 1])
        i = i + 1
    j := 0
    while j < (n_up - 1):
        out.push(upper[j * 2])
        out.push(upper[(j * 2) + 1])
        j = j + 1
