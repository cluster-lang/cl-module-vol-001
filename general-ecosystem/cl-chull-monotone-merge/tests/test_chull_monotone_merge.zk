// cl-chull-monotone-merge: Test Suite
import "../hull_merge.zk"

fn test_hull_merge():
    low: vector[int] := [0, 0, 5, 0, 10, 0]
    up: vector[int] := [10, 0, 5, 5, 0, 0]
    out: vector[int] := []
    merge_hull_chains(out, low, up)
    // 2 points from low + 2 points from up = 4 points = 8 ints
    if out.len() != 8: sys_exit(1)
    print("test_hull_merge passed: monotone chain combination verified")

fn main():
    test_hull_merge()
    print("✓ All tests passed for cl-chull-monotone-merge!")
