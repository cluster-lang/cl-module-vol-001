// cl-cad-bezier-weight-norm-stage-49: Test Suite
import "../bez_wn_49.zk"

fn test_run():
    res := bezier_weight_norm_49(1.0, 2.0, 0.5, 0.5)
    diff := res - 73.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
