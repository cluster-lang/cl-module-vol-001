fn count_ones64(val: int) -> int:
    mask64 := 9223372036854775807
    v := val & mask64
    count := 0
    while v > 0:
        count = count + (v & 1)
        v = v >> 1
    return count

fn bloom_difference(filter_a: vector[int], filter_b: vector[int]) -> vector[int]:
    out: vector[int] := []
    n := filter_a.len()
    mask64 := 9223372036854775807
    i := 0
    while i < n:
        va := filter_a[i] & mask64
        vb := filter_b[i] & mask64
        diff := va & (~vb)
        out.push(diff & mask64)
        i = i + 1
    return out

fn bloom_diff_count(diff_filter: vector[int]) -> int:
    total := 0
    n := diff_filter.len()
    i := 0
    while i < n:
        total = total + count_ones64(diff_filter[i])
        i = i + 1
    return total
