// cl-bspline-cubic-basis: Test Suite
import "../bspline_cubic.zk"

fn test_bspline_cubic():
    w0 := bspline_cubic_weight0(0.0)
    diff0 := w0 - (1.0 / 6.0)
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    w3 := bspline_cubic_weight3(1.0)
    diff3 := w3 - (1.0 / 6.0)
    if diff3 < 0.0: diff3 = 0.0 - diff3
    if diff3 > 0.001: sys_exit(1)
    print("test_bspline_cubic passed: cubic B-spline weights verified")

fn main():
    test_bspline_cubic()
    print("✓ All tests passed for cl-bspline-cubic-basis!")
