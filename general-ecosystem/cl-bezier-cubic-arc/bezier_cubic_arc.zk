// cl-bezier-cubic-arc: Cubic Bézier Arc Length via Midpoint Integration
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bezier_cubic_length(x0: float, y0: float, x1: float, y1: float, x2: float, y2: float, x3: float, y3: float, steps: int) -> float:
    dt := 1.0 / (steps * 1.0)
    t := 0.0
    total := 0.0
    i := 0
    while i < steps:
        t_mid := t + (dt * 0.5)
        mt := 1.0 - t_mid
        // Derivative: 3*(1-t)^2*(P1-P0) + 6*(1-t)*t*(P2-P1) + 3*t^2*(P3-P2)
        dx := (3.0 * mt * mt * (x1 - x0)) + (6.0 * mt * t_mid * (x2 - x1)) + (3.0 * t_mid * t_mid * (x3 - x2))
        dy := (3.0 * mt * mt * (y1 - y0)) + (6.0 * mt * t_mid * (y2 - y1)) + (3.0 * t_mid * t_mid * (y3 - y2))
        speed_sq := (dx * dx) + (dy * dy)
        speed := 0.0
        if speed_sq > 0.000001:
            s := speed_sq * 0.5
            if speed_sq <= 1.0: s = 1.0
            k := 0
            while k < 6:
                s = (s + (speed_sq / s)) * 0.5
                k = k + 1
            speed = s
        total = total + (speed * dt)
        t = t + dt
        i = i + 1
    return total
