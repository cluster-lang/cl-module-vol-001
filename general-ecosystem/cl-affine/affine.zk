fn affine_encrypt(s: string, a: int, b: int) -> string:
    res := ""
    i := 0
    slen := len(s)
    while i < slen:
        ch := byte_at(s, i)
        if ch >= 65 and ch <= 90:
            res = res + chr((((a * (ch - 65)) + b) % 26) + 65)
        elif ch >= 97 and ch <= 122:
            res = res + chr((((a * (ch - 97)) + b) % 26) + 97)
        else:
            res = res + chr(ch)
        i = i + 1
    return res

fn affine_decrypt(s: string, a_inv: int, b: int) -> string:
    res := ""
    i := 0
    slen := len(s)
    while i < slen:
        ch := byte_at(s, i)
        if ch >= 65 and ch <= 90:
            diff := (ch - 65 - b) % 26
            if diff < 0: diff = diff + 26
            res = res + chr(((a_inv * diff) % 26) + 65)
        elif ch >= 97 and ch <= 122:
            diff := (ch - 97 - b) % 26
            if diff < 0: diff = diff + 26
            res = res + chr(((a_inv * diff) % 26) + 97)
        else:
            res = res + chr(ch)
        i = i + 1
    return res
