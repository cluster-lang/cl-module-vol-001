// cl-base45: Test Suite
import "../base45.zk"

fn test_b45():
    out: vector[int] := []
    // Test pair (0, 0) -> (0, 0, 0)
    base45_encode_pair(0, 0, out)
    if out.len() != 3: sys_exit(1)
    if out[0] != 0: sys_exit(1)
    if out[1] != 0: sys_exit(1)
    if out[2] != 0: sys_exit(1)
    print("test_b45 passed: Base45 pair encode verified")

fn main():
    test_b45()
    print("✓ All tests passed for cl-base45!")
