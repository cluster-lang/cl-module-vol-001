// Encodes 2 bytes (0-65535) into 3 base45 digits: n = c + d*45 + e*45*45
fn base45_encode_pair(b1: int, b2: int, out: vector[int]):
    val := ((b1 & 255) << 8) | (b2 & 255)
    c := val % 45
    val = val / 45
    d := val % 45
    e := val / 45
    out.push(c)
    out.push(d)
    out.push(e)
