// cl-char-to-digit-value: Convert ASCII Digit Character [0-9] to Numeric Integer
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn char_to_digit(c: int) -> int:
    if c >= 48 and c <= 57: return c - 48
    return 0 - 1
