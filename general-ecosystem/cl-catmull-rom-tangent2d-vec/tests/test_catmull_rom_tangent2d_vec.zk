// cl-catmull-rom-tangent2d-vec: Test Suite
import "../catmull_tan2d.zk"

fn test_catmull_tan2d():
    p0: vector[float] := [0.0, 0.0]
    p1: vector[float] := [10.0, 0.0]
    p2: vector[float] := [20.0, 0.0]
    p3: vector[float] := [30.0, 0.0]
    out: vector[float] := []
    catmull_tangent2d_vec(out, p0, p1, p2, p3, 0.0)
    diff := out[0] - 10.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_catmull_tan2d passed: 2D tangent vector verified")

fn main():
    test_catmull_tan2d()
    print("✓ All tests passed for cl-catmull-rom-tangent2d-vec!")
