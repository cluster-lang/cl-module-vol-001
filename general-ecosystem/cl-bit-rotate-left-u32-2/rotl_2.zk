// cl-bit-rotate-left-u32-2: 32-Bit Unsigned Integer Rotate Left by 2 Bits
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rot_left_u32_2(val: int) -> int:
    mask32 := 4294967295
    v := val & mask32
    res := ((v << 2) | (v >> 30)) & mask32
    return res
