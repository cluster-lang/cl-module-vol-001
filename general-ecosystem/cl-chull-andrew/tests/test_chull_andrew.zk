// cl-chull-andrew: Test Suite
import "../chull_andrew.zk"

fn test_andrew():
    // (0,0) -> (1,0) -> (1,1) is a left turn (ccw): cross product > 0
    cp := cross_product_2d(0, 0, 1, 0, 1, 1)
    if cp <= 0: sys_exit(1)
    print("test_andrew passed: 2D cross product verified")

fn main():
    test_andrew()
    print("✓ All tests passed for cl-chull-andrew!")
