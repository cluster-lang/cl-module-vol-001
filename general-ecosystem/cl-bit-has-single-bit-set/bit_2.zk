// cl-bit-has-single-bit-set: Check If Exactly One Bit Is Set (Power of Two)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn has_single_bit_set(val: int) -> int:
    if val <= 0: return 0
    if (val & (val - 1)) == 0: return 1
    return 0
