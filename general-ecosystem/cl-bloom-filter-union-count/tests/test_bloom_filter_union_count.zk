// cl-bloom-filter-union-count: Test Suite
import "../bloom_union_cnt.zk"

fn test_bloom_union_cnt():
    fa: vector[int] := [3]
    fb: vector[int] := [5]
    c := bloom_union_bit_count(fa, fb)
    if c != 3: sys_exit(1)
    print("test_bloom_union_cnt passed: union active bit count 3 verified")

fn main():
    test_bloom_union_cnt()
    print("✓ All tests passed for cl-bloom-filter-union-count!")
