// cl-bloom-filter-union-count: Count Active Bits in Bloom Union without Full Allocation
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn count_ones64(val: int) -> int:
    mask64 := 9223372036854775807
    v := val & mask64
    count := 0
    while v > 0:
        count = count + (v & 1)
        v = v >> 1
    return count

fn bloom_union_bit_count(fa: vector[int], fb: vector[int]) -> int:
    total := 0
    n := fa.len()
    mask64 := 9223372036854775807
    i := 0
    while i < n:
        u := (fa[i] | fb[i]) & mask64
        total = total + count_ones64(u)
        i = i + 1
    return total
