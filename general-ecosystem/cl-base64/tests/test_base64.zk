// cl-base64: Test Suite
import "../base64.zk"

fn test_base64():
    if base64_encode_str("") != "": sys_exit(1)
    if base64_encode_str("f") != "Zg==": sys_exit(1)
    if base64_encode_str("fo") != "Zm8=": sys_exit(1)
    if base64_encode_str("foo") != "Zm9v": sys_exit(1)
    print("test_base64 passed: RFC 4648 Base64 verified")

fn main():
    test_base64()
    print("✓ All tests passed for cl-base64!")
