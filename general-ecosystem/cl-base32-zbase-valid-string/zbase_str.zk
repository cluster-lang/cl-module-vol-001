// cl-base32-zbase-valid-string: Validate z-base-32 String Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn is_valid_zbase_char(code: int) -> int:
    if code == 48 or code == 118 or code == 50 or code == 108:
        return 0
    if code == 49 or (code >= 51 and code <= 57):
        return 1
    if code >= 97 and code <= 122:
        return 1
    return 0

fn is_valid_zbase_string(text: vector[int]) -> int:
    n := text.len()
    i := 0
    while i < n:
        if is_valid_zbase_char(text[i]) == 0:
            return 0
        i = i + 1
    return 1
