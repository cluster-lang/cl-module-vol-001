// cl-base58-char-to-val: Base58 Alphanumeric Character to Integer Value
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn base58_char_to_val(c: int) -> int:
    if c >= 49 and c <= 57: return c - 49
    if c >= 65 and c <= 72: return c - 65 + 9
    if c >= 74 and c <= 78: return c - 74 + 17
    return 0
