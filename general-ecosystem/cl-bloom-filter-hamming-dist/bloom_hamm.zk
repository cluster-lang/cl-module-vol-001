fn count_ones64(val: int) -> int:
    mask64 := 9223372036854775807
    v := val & mask64
    count := 0
    while v > 0:
        count = count + (v & 1)
        v = v >> 1
    return count

fn bloom_hamming_distance(fa: vector[int], fb: vector[int]) -> int:
    total := 0
    n := fa.len()
    mask64 := 9223372036854775807
    i := 0
    while i < n:
        diff := (fa[i] ^ fb[i]) & mask64
        total = total + count_ones64(diff)
        i = i + 1
    return total
