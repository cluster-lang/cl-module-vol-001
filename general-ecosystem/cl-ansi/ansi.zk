fn ansi_reset() -> string:
    return "[0m"

fn ansi_bold(s: string) -> string:
    return "[1m" + s + "[0m"

fn ansi_red(s: string) -> string:
    return "[31m" + s + "[0m"

fn ansi_green(s: string) -> string:
    return "[32m" + s + "[0m"

fn ansi_cyan(s: string) -> string:
    return "[36m" + s + "[0m"
