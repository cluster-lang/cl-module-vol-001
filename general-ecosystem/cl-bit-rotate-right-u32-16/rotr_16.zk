// cl-bit-rotate-right-u32-16: 32-Bit Unsigned Integer Rotate Right by 16 Bits
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rot_right_u32_16(val: int) -> int:
    mask32 := 4294967295
    v := val & mask32
    res := ((v >> 16) | (v << 16)) & mask32
    return res
