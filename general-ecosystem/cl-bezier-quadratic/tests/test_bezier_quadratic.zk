// cl-bezier-quadratic: Test Suite
import "../bezier_quad.zk"

fn test_bezier_quad():
    v0 := bezier_quadratic_1d(100, 200, 300, 0)
    if v0 != 100: sys_exit(1)

    v1 := bezier_quadratic_1d(100, 200, 300, 1000)
    if v1 != 300: sys_exit(1)

    v_mid := bezier_quadratic_1d(0, 1000, 0, 500)
    if v_mid != 500: sys_exit(1)
    print("test_bezier_quad passed: quadratic polynomial interpolation verified")

fn main():
    test_bezier_quad()
    print("✓ All tests passed for cl-bezier-quadratic!")
