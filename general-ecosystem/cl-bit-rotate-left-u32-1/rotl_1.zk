// cl-bit-rotate-left-u32-1: 32-Bit Unsigned Integer Rotate Left by 1 Bits
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rot_left_u32_1(val: int) -> int:
    mask32 := 4294967295
    v := val & mask32
    res := ((v << 1) | (v >> 31)) & mask32
    return res
