// cl-bezier-cubic-split-third: Test Suite
import "../b3_split.zk"

fn test_b3_split():
    p0: vector[float] := [0.0, 0.0]
    p1: vector[float] := [3.0, 0.0]
    p2: vector[float] := [3.0, 3.0]
    p3: vector[float] := [0.0, 3.0]
    mid: vector[float] := [0.0, 0.0]
    bezier_cubic_split_mid(mid, p0, p1, p2, p3)
    // s0 = (2.25, 1.5)
    diff_x := mid[0] - 2.25
    if diff_x < 0.0: diff_x = 0.0 - diff_x
    diff_y := mid[1] - 1.5
    if diff_y < 0.0: diff_y = 0.0 - diff_y
    if diff_x > 0.0001 or diff_y > 0.0001: sys_exit(1)
    print("test_b3_split passed")

fn main():
    test_b3_split()
    print("✓ All tests passed for cl-bezier-cubic-split-third!")
