// cl-bspline-uniform-basis-cubic: Uniform Cubic B-Spline Basis Weights Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bspline_cubic_basis_all(out: vector[float], t: float):
    omt := 1.0 - t
    t2 := t * t
    t3 := t2 * t
    w0 := (omt * omt * omt) / 6.0
    w1 := (3.0 * t3 - 6.0 * t2 + 4.0) / 6.0
    w2 := (-3.0 * t3 + 3.0 * t2 + 3.0 * t + 1.0) / 6.0
    w3 := t3 / 6.0
    out.push(w0)
    out.push(w1)
    out.push(w2)
    out.push(w3)
