// cl-bspline-uniform-basis-cubic: Test Suite
import "../bspline_cubic_w.zk"

fn test_bspline_cubic_w():
    out: vector[float] := []
    bspline_cubic_basis_all(out, 0.0)
    // At t=0: w0 = 1/6, w1 = 4/6, w2 = 1/6, w3 = 0
    sum := out[0] + out[1] + out[2] + out[3]
    diff := sum - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_bspline_cubic_w passed: partition of unity verified")

fn main():
    test_bspline_cubic_w()
    print("✓ All tests passed for cl-bspline-uniform-basis-cubic!")
