// cl-bezier-cubic-arc-length-approx: Cubic Bezier Arc Length Estimator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sqrt_approx(val: float) -> float:
    if val <= 0.0:
        return 0.0
    x := val
    i := 0
    while i < 15:
        x = 0.5 * (x + val / x)
        i = i + 1
    return x

fn bezier_cubic_point(p0: float, p1: float, p2: float, p3: float, t: float) -> float:
    u := 1.0 - t
    return u * u * u * p0 + 3.0 * u * u * t * p1 + 3.0 * u * t * t * p2 + t * t * t * p3

fn bezier_cubic_length4(p0x: float, p0y: float, p1x: float, p1y: float, p2x: float, p2y: float, p3x: float, p3y: float) -> float:
    total := 0.0
    prev_x := p0x
    prev_y := p0y
    i := 1
    while i <= 4:
        t := float(i) * 0.25
        cur_x := bezier_cubic_point(p0x, p1x, p2x, p3x, t)
        cur_y := bezier_cubic_point(p0y, p1y, p2y, p3y, t)
        dx := cur_x - prev_x
        dy := cur_y - prev_y
        total = total + sqrt_approx(dx * dx + dy * dy)
        prev_x = cur_x
        prev_y = cur_y
        i = i + 1
    return total
