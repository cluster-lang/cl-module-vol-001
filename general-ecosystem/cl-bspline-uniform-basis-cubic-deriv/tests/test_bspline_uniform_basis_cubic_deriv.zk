// cl-bspline-uniform-basis-cubic-deriv: Test Suite
import "../bs_deriv.zk"

fn test_bs_deriv():
    d: vector[float] := [0.0, 0.0, 0.0, 0.0]
    bspline_cubic_basis_deriv(0.5, d)
    // At u=0.5: sum of derivatives must equal identically 0.0
    sum := d[0] + d[1] + d[2] + d[3]
    sum_abs := sum
    if sum_abs < 0.0: sum_abs = 0.0 - sum_abs
    if sum_abs > 0.0001: sys_exit(1)
    print("test_bs_deriv passed")

fn main():
    test_bs_deriv()
    print("✓ All tests passed for cl-bspline-uniform-basis-cubic-deriv!")
