fn bspline_cubic_basis_deriv(u: float, out_d: vector[float]):
    out_d[0] = (0.0 - 0.5) * (1.0 - u) * (1.0 - u)
    out_d[1] = 1.5 * u * u - 2.0 * u
    out_d[2] = (0.0 - 1.5) * u * u + u + 0.5
    out_d[3] = 0.5 * u * u
