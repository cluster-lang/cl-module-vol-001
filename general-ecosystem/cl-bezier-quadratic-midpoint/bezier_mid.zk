// cl-bezier-quadratic-midpoint: Quadratic Bezier Curve Midpoint Evaluator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bezier_quad_midpoint(p0: float, p1: float, p2: float) -> float:
    return 0.25 * p0 + 0.5 * p1 + 0.25 * p2
