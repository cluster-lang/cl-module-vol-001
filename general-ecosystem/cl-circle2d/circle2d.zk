fn circle_contains_point(cx: int, cy: int, r: int, px: int, py: int) -> int:
    dx := px - cx
    dy := py - cy
    if ((dx * dx) + (dy * dy)) <= (r * r): return 1
    return 0

fn circle_intersects_circle(c1x: int, c1y: int, r1: int, c2x: int, c2y: int, r2: int) -> int:
    dx := c2x - c1x
    dy := c2y - c1y
    dsq := (dx * dx) + (dy * dy)
    r_sum := r1 + r2
    if dsq <= (r_sum * r_sum): return 1
    return 0
