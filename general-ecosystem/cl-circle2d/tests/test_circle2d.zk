// cl-circle2d: Test Suite
import "../circle2d.zk"

fn test_circle():
    // Circle at (0,0) radius 5
    if circle_contains_point(0, 0, 5, 3, 4) != 1: sys_exit(1) // 3^2+4^2=25
    if circle_contains_point(0, 0, 5, 4, 4) != 0: sys_exit(1) // 4^2+4^2=32

    // Circle (0,0, r=5) and (6,0, r=2) overlap
    if circle_intersects_circle(0, 0, 5, 6, 0, 2) != 1: sys_exit(1)
    // Circle (0,0, r=5) and (10,0, r=2) do not overlap
    if circle_intersects_circle(0, 0, 5, 10, 0, 2) != 0: sys_exit(1)
    print("test_circle passed: 2D circle geometry verified")

fn main():
    test_circle()
    print("✓ All tests passed for cl-circle2d!")
