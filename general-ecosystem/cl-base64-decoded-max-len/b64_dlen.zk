// cl-base64-decoded-max-len: Base64 Upper Bound Decoded Length
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn base64_decoded_max_length(char_len: int) -> int:
    if char_len <= 0: return 0
    return (char_len * 3) / 4
