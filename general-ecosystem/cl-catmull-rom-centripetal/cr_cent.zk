// Centripetal: dt = (dist)^0.5. Approx sqrt via 6 newton steps.
fn centripetal_dt(x1: float, y1: float, x2: float, y2: float) -> float:
    dx := x2 - x1
    dy := y2 - y1
    dist_sq := (dx * dx) + (dy * dy)
    if dist_sq < 0.000001: return 0.0
    // sqrt(dist_sq) = dist
    s := dist_sq * 0.5
    if dist_sq <= 1.0: s = 1.0
    k := 0
    while k < 6:
        s = (s + (dist_sq / s)) * 0.5
        k = k + 1
    dist := s
    // sqrt(dist)
    s2 := dist * 0.5
    if dist <= 1.0: s2 = 1.0
    k = 0
    while k < 6:
        s2 = (s2 + (dist / s2)) * 0.5
        k = k + 1
    return s2
