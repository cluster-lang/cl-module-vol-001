// cl-bezier-quad-length: Quadratic Bézier Arc Length via Numerical Integration
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bezier_quad_arc_length(x0: float, y0: float, x1: float, y1: float, x2: float, y2: float, steps: int) -> float:
    dt := 1.0 / (steps * 1.0)
    t := 0.0
    total := 0.0
    // Segment midpoint approximation
    i := 0
    while i < steps:
        t_mid := t + (dt * 0.5)
        // Derivative: B'(t) = 2*(1-t)*(P1-P0) + 2*t*(P2-P1)
        dx := (2.0 * (1.0 - t_mid) * (x1 - x0)) + (2.0 * t_mid * (x2 - x1))
        dy := (2.0 * (1.0 - t_mid) * (y1 - y0)) + (2.0 * t_mid * (y2 - y1))
        speed_sq := (dx * dx) + (dy * dy)
        speed := 0.0
        if speed_sq > 0.000001:
            s := speed_sq * 0.5
            if speed_sq <= 1.0: s = 1.0
            k := 0
            while k < 6:
                s = (s + (speed_sq / s)) * 0.5
                k = k + 1
            speed = s
        total = total + (speed * dt)
        t = t + dt
        i = i + 1
    return total
