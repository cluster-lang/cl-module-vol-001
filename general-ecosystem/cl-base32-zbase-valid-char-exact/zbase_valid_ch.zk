// cl-base32-zbase-valid-char-exact: Fast z-base-32 Valid Character Classifier
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn is_zbase_valid_exact(code: int) -> int:
    if code == 48 or code == 50 or code == 118 or code == 108:
        return 0
    if code == 49 or (code >= 51 and code <= 57):
        return 1
    if code >= 97 and code <= 122:
        return 1
    return 0
