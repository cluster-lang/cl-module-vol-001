// cl-bezier: Test Suite
import "../bezier.zk"

fn test_bezier():
    b0 := bezier_quad(0, 50, 100, 50)
    if b0 != 50: sys_exit(1)
    c0 := bezier_cubic(0, 33, 66, 100, 50)
    if c0 < 49 or c0 > 51: sys_exit(1)
    print("test_bezier passed: Bézier interpolation verified")

fn main():
    test_bezier()
    print("✓ All tests passed for cl-bezier!")
