// cl-cad-nurbs-knot-span-stage-94: Test Suite
import "../nrb_ks_94.zk"

fn test_run():
    res := nurbs_knot_span_94(5.0, 2.0)
    diff := res - 282.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cad-nurbs-knot-span-stage-94!")
