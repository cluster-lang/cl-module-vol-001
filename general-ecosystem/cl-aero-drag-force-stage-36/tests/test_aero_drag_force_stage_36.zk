// cl-aero-drag-force-stage-36: Test Suite
import "../drag_f_36.zk"

fn test_run():
    res := drag_force_36(100.0, 2.0, 0.02)
    diff := res - 144.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-drag-force-stage-36!")
