// cl-bezier-cubic-curvature: Test Suite
import "../bezier_c_curv.zk"

fn test_bezier_c_curv():
    k := bezier_curvature_formula(3.0, 0.0, 0.0, 9.0)
    // cross = 27, speed = 3, speed_sq = 9 -> denom = 27 -> k = 1.0
    diff := k - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_bezier_c_curv passed: curvature 1.0 verified")

fn main():
    test_bezier_c_curv()
    print("✓ All tests passed for cl-bezier-cubic-curvature!")
