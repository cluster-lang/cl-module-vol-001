// cl-base32-crockford-encode-char: Crockford Base32 5-bit Encoder
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn crockford_encode_5bit(val: int) -> int:
    v := val & 31
    if v < 10:
        return 48 + v // '0'..'9'
    // 10..17 -> 'A'..'H' (skip I)
    if v < 18:
        return 65 + (v - 10)
    // 18..19 -> 'J'..'K'
    if v < 20:
        return 74 + (v - 18)
    // 20..26 -> 'M'..'T' (skip L)
    if v < 27:
        return 77 + (v - 20)
    // 27..31 -> 'V'..'Z' (skip U)
    return 86 + (v - 27)
