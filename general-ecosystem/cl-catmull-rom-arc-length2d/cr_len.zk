// cl-catmull-rom-arc-length2d: 2D Catmull-Rom Segment Arc Length Approximator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sqrt_approx(val: float) -> float:
    if val <= 0.0: return 0.0
    x := val
    i := 0
    while i < 15:
        x = 0.5 * (x + val / x)
        i = i + 1
    return x

fn catmull_rom_eval(p0: float, p1: float, p2: float, p3: float, t: float) -> float:
    t2 := t * t
    t3 := t2 * t
    c0 := 0.0 - 0.5 * p0 + 1.5 * p1 - 1.5 * p2 + 0.5 * p3
    c1 := p0 - 2.5 * p1 + 2.0 * p2 - 0.5 * p3
    c2 := 0.0 - 0.5 * p0 + 0.5 * p2
    c3 := p1
    return c0 * t3 + c1 * t2 + c2 * t + c3

fn catmull_rom_length4(p0x: float, p0y: float, p1x: float, p1y: float, p2x: float, p2y: float, p3x: float, p3y: float) -> float:
    total := 0.0
    prev_x := p1x
    prev_y := p1y
    i := 1
    while i <= 4:
        t := float(i) * 0.25
        cx := catmull_rom_eval(p0x, p1x, p2x, p3x, t)
        cy := catmull_rom_eval(p0y, p1y, p2y, p3y, t)
        dx := cx - prev_x
        dy := cy - prev_y
        total = total + sqrt_approx(dx * dx + dy * dy)
        prev_x = cx
        prev_y = cy
        i = i + 1
    return total
