// cl-bloom-filter-hasher: Test Suite
import "../bloom_h.zk"

fn test_bloom_h():
    out: vector[int] := []
    bloom_generate_k_hashes(100, 20, 3, 1000, out)
    if out.len() != 3: sys_exit(1)
    if out[0] != 100: sys_exit(1)
    if out[1] != 120: sys_exit(1)
    if out[2] != 140: sys_exit(1)
    print("test_bloom_h passed: k-hash sequence generated verified")

fn main():
    test_bloom_h()
    print("✓ All tests passed for cl-bloom-filter-hasher!")
