// cl-bit-count-trailing-zeros: 64-bit Count Trailing Zeros (CTZ)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn count_trailing_zeros(x: int) -> int:
    if x == 0: return 64
    count := 0
    val := x
    while (val & 1) == 0:
        count = count + 1
        val = val >> 1
    return count
