// cl-bvh-leaf-sort: Test Suite
import "../morton.zk"

fn test_morton():
    // (1, 1) -> y=1, x=1 -> (1<<1)|1 = 3
    m := morton2d(1, 1)
    if m != 3: sys_exit(1)
    print("test_morton passed: 2D Morton Z-order code verified")

fn main():
    test_morton()
    print("✓ All tests passed for cl-bvh-leaf-sort!")
