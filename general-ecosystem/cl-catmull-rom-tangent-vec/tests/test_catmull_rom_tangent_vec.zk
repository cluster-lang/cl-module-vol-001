// cl-catmull-rom-tangent-vec: Test Suite
import "../catmull_tan.zk"

fn test_catmull_tan():
    // At t=0, tangent is 0.5 * (p2 - p0)
    tan := catmull_rom_tangent(0.0, 5.0, 10.0, 15.0, 0.0)
    diff := tan - 5.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_catmull_tan passed: endpoint tangent 5.0 verified")

fn main():
    test_catmull_tan()
    print("✓ All tests passed for cl-catmull-rom-tangent-vec!")
