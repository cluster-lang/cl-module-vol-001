// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn catmull_chordal_tangent1(p0: float, p1: float, p2: float, dt0: float, dt1: float) -> float:
    if (dt0 + dt1) <= 0.000001: return 0.0
    return ((p1 - p0) / dt0 + (p2 - p1) / dt1) * 0.5
