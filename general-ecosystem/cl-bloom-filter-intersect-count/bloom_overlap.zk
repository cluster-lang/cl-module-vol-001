fn lshr64(val: int, shift: int) -> int:
    if shift == 0: return val
    mask := (1 << (64 - shift)) - 1
    return (val >> shift) & mask

fn bloom_intersection_bits(f1: int, f2: int) -> int:
    common := f1 & f2
    count := 0
    v := common
    i := 0
    while i < 64:
        if (v & 1) == 1: count = count + 1
        v = lshr64(v, 1)
        i = i + 1
    return count
