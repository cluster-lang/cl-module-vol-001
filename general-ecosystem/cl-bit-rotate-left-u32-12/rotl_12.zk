// cl-bit-rotate-left-u32-12: 32-Bit Unsigned Integer Rotate Left by 12 Bits
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rot_left_u32_12(val: int) -> int:
    mask32 := 4294967295
    v := val & mask32
    res := ((v << 12) | (v >> 20)) & mask32
    return res
