// cl-base32-crockford-decode-char: Crockford Base32 Character Decoder
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn crockford_decode_char(c: int) -> int:
    if c >= 48:
        if c <= 57: return c - 48
    if c >= 65:
        if c <= 72: return 10 + (c - 65)
    if c >= 74:
        if c <= 75: return 18 + (c - 74)
    if c >= 77:
        if c <= 78: return 20 + (c - 77)
    if c >= 80:
        if c <= 84: return 22 + (c - 80)
    if c >= 86:
        if c <= 90: return 27 + (c - 86)
    return -1
