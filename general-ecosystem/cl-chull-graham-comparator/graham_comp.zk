// cl-chull-graham-comparator: Polar Angle Graham Scan Comparator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

// Returns 1 if p1 has smaller polar angle than p2 relative to origin p0
fn graham_compare(p0x: int, p0y: int, p1x: int, p1y: int, p2x: int, p2y: int) -> int:
    cp := ((p1x - p0x) * (p2y - p0y)) - ((p1y - p0y) * (p2x - p0x))
    if cp > 0: return 1
    return 0
