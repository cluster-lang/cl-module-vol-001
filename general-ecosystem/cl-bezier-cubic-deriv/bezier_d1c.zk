// cl-bezier-cubic-deriv: Cubic Bezier Curve Velocity Derivative
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bezier_cubic_deriv(p0: float, p1: float, p2: float, p3: float, t: float) -> float:
    // C'(t) = 3(1-t)^2 (p1 - p0) + 6(1-t)t (p2 - p1) + 3t^2 (p3 - p2)
    omt := 1.0 - t
    term0 := 3.0 * omt * omt * (p1 - p0)
    term1 := 6.0 * omt * t * (p2 - p1)
    term2 := 3.0 * t * t * (p3 - p2)
    return term0 + term1 + term2
