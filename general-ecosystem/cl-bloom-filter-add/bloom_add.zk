// cl-bloom-filter-add: Bloom Filter Double-Hash Insertion Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bloom_add_double(filter: int, h1: int, h2: int) -> int:
    m1 := 1 << (h1 & 63)
    m2 := 1 << (h2 & 63)
    return filter | m1 | m2
