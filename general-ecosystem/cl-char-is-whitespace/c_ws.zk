// cl-char-is-whitespace: Check If ASCII Value Is Whitespace (Space, Tab, LF, CR)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn char_is_whitespace(c: int) -> int:
    if c == 32 or c == 9 or c == 10 or c == 13: return 1
    return 0
