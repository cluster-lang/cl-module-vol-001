// cl-bezier-cubic-split: De Casteljau Midpoint Splitter for Cubic Curve
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bezier_cubic_split_half(out_left: vector[float], out_right: vector[float], p0: float, p1: float, p2: float, p3: float):
    q0 := (p0 + p1) * 0.5
    q1 := (p1 + p2) * 0.5
    q2 := (p2 + p3) * 0.5
    r0 := (q0 + q1) * 0.5
    r1 := (q1 + q2) * 0.5
    s := (r0 + r1) * 0.5

    out_left.push(p0)
    out_left.push(q0)
    out_left.push(r0)
    out_left.push(s)

    out_right.push(s)
    out_right.push(r1)
    out_right.push(q2)
    out_right.push(p3)
