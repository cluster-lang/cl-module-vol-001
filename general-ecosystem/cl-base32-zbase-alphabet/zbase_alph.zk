// Alphabet: ybndrfg8ejkmcpqxot1uwisza345h769
fn zbase_char_at(idx: int) -> int:
    i := idx & 31
    if i == 0: return 121  // 'y'
    if i == 1: return 98   // 'b'
    if i == 2: return 110  // 'n'
    if i == 3: return 100  // 'd'
    if i == 31: return 57  // '9'
    return 120            // 'x' default
