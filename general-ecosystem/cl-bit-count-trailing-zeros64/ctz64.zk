// cl-bit-count-trailing-zeros64: 64-bit Trailing Zeros Counter Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lshr64(val: int, shift: int) -> int:
    if shift == 0: return val
    mask := (1 << (64 - shift)) - 1
    return (val >> shift) & mask

fn ctz64(val: int) -> int:
    if val == 0: return 64
    count := 0
    v := val
    cont := 1
    while cont == 1:
        if (v & 1) == 0:
            count = count + 1
            v = lshr64(v, 1)
        else:
            cont = 0
    return count
