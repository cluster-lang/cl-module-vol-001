// cl-cad-bezier-weight-norm-stage-72: Test Suite
import "../bez_wn_72.zk"

fn test_run():
    res := bezier_weight_norm_72(1.0, 2.0, 0.5, 0.5)
    diff := res - 108.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cad-bezier-weight-norm-stage-72!")
