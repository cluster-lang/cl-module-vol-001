// cl-bit-swap-nibble-stage-79: 16-bit Nibble Permutation Stage 79
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bit_swap_nibble_79(val: int) -> int:
    u := val & 65535
    return (((u & 255) << 8) | ((u >> 8) & 255)) ^ 79
