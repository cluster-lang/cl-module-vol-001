// cl-bezier-cubic: Test Suite
import "../bezier_cubic.zk"

fn test_bezier():
    // At t=0, val should equal p0
    v0 := bezier_cubic_1d(100, 200, 300, 400, 0)
    if v0 != 100: sys_exit(1)

    // At t=1000, val should equal p3
    v1 := bezier_cubic_1d(100, 200, 300, 400, 1000)
    if v1 != 400: sys_exit(1)

    // At t=500, mid-point evaluation
    v_mid := bezier_cubic_1d(0, 1000, 1000, 0, 500)
    if v_mid != 750: sys_exit(1)
    print("test_bezier passed: Bernstein cubic polynomials verified")

fn main():
    test_bezier()
    print("✓ All tests passed for cl-bezier-cubic!")
