// cl-aero-dynamic-pressure-stage-8: Test Suite
import "../dyn_pr_8.zk"

fn test_run():
    res := dynamic_pressure_8(1.225, 10.0)
    diff := res - 490.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-dynamic-pressure-stage-8!")
