// cl-catmull-rom-centripetal-knot: Test Suite
import "../centripetal_knot.zk"

fn test_centripetal_knot():
    // dx=0, dy=16 -> dist=16, sqrt_dist=4 -> t_next = 4.0
    t_next := centripetal_knot_step(0.0, 0.0, 16.0)
    diff := t_next - 4.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_centripetal_knot passed: centripetal knot step 4.0 verified")

fn main():
    test_centripetal_knot()
    print("✓ All tests passed for cl-catmull-rom-centripetal-knot!")
