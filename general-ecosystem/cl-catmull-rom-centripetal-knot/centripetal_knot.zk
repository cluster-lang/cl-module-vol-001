fn sqrt_approx(val: float) -> float:
    if val <= 0.0: return 0.0
    s := val * 0.5
    if s < 1.0: s = 1.0
    iter := 0
    while iter < 6:
        s = (s + val / s) * 0.5
        iter = iter + 1
    return s

fn centripetal_knot_step(t_prev: float, dx: float, dy: float) -> float:
    dsq := dx * dx + dy * dy
    dist := sqrt_approx(dsq)
    sqrt_dist := sqrt_approx(dist)
    return t_prev + sqrt_dist
