fn aho_find_first_match(keywords: vector[string], text: string) -> int:
    tlen := len(text)
    klen := keywords.len()
    i := 0
    while i < tlen:
        k := 0
        while k < klen:
            kw := keywords[k]
            kw_len := len(kw)
            if (i + kw_len) <= tlen:
                is_match := 1
                j := 0
                while j < kw_len:
                    if byte_at(text, i + j) != byte_at(kw, j):
                        is_match = 0
                    j = j + 1
                if is_match == 1:
                    return k
            k = k + 1
        i = i + 1
    return -1
