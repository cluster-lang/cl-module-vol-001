// cl-catmull-rom-tangent2d: 2D Catmull-Rom Tangent Vector Evaluator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cr_tangent_1d(p0: float, p1: float, p2: float, p3: float, t: float) -> float:
    c0 := 0.5 * (p2 - p0)
    c1 := 0.5 * ((2.0 * p0) - (5.0 * p1) + (4.0 * p2) - p3)
    c2 := 0.5 * (-p0 + (3.0 * p1) - (3.0 * p2) + p3)
    return c0 + (2.0 * c1 * t) + (3.0 * c2 * t * t)

fn cr_tangent_2d(out: vector[float], x0: float, y0: float, x1: float, y1: float, x2: float, y2: float, x3: float, y3: float, t: float):
    out.push(cr_tangent_1d(x0, x1, x2, x3, t))
    out.push(cr_tangent_1d(y0, y1, y2, y3, t))
