// cl-catmull-rom-tangent2d: Test Suite
import "../cr_tan2d.zk"

fn test_cr_tan2d():
    out: vector[float] := []
    // Horizontal line y=0, x spacing 10
    cr_tangent_2d(out, 0.0, 0.0, 10.0, 0.0, 20.0, 0.0, 30.0, 0.0, 0.5)
    if out[0] < 9.99: sys_exit(1)
    if out[0] > 10.01: sys_exit(1)
    if out[1] != 0.0: sys_exit(1)
    print("test_cr_tan2d passed: 2D Catmull-Rom tangent vector verified")

fn main():
    test_cr_tan2d()
    print("✓ All tests passed for cl-catmull-rom-tangent2d!")
