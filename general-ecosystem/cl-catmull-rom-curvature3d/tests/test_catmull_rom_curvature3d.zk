// cl-catmull-rom-curvature3d: Test Suite
import "../cr_curv.zk"

fn test_cr_curv():
    p0: vector[float] := [0.0, 0.0, 0.0]
    p1: vector[float] := [1.0, 0.0, 0.0]
    p2: vector[float] := [1.0, 1.0, 0.0]
    p3: vector[float] := [0.0, 1.0, 0.0]
    val := catmull_rom_curvature3d(p0, p1, p2, p3, 0.5)
    if val <= 0.0: sys_exit(1)
    print("test_cr_curv passed")

fn main():
    test_cr_curv()
    print("✓ All tests passed for cl-catmull-rom-curvature3d!")
