// cl-aero-dynamic-pressure-stage-25: Test Suite
import "../dyn_pr_25.zk"

fn test_run():
    res := dynamic_pressure_25(1.225, 10.0)
    diff := res - 1531.2500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-dynamic-pressure-stage-25!")
