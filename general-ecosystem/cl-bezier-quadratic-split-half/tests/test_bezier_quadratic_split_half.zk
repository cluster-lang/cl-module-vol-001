// cl-bezier-quadratic-split-half: Test Suite
import "../bezier_half.zk"

fn test_bezier_half():
    left: vector[float] := []
    right: vector[float] := []
    bezier_quad_split_mid(left, right, 0.0, 10.0, 20.0)
    if left[0] != 0.0: sys_exit(1)
    if left[1] != 5.0: sys_exit(1)
    if left[2] != 10.0: sys_exit(1)
    if right[0] != 10.0: sys_exit(1)
    if right[1] != 15.0: sys_exit(1)
    if right[2] != 20.0: sys_exit(1)
    print("test_bezier_half passed: quadratic Bezier midpoint split verified")

fn main():
    test_bezier_half()
    print("✓ All tests passed for cl-bezier-quadratic-split-half!")
