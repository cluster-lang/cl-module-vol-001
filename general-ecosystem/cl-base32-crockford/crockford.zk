// cl-base32-crockford: Douglas Crockford's Human-Readable Base32
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn crockford_char(val: int) -> string:
    alphabet := "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    v := val & 31
    return chr(byte_at(alphabet, v))

fn crockford_encode_int(val: int) -> string:
    if val == 0: return "0"
    v := val
    res := ""
    while v > 0:
        res = crockford_char(v % 32) + res
        v = v / 32
    return res
