// cl-bspline-cubic-eval: Test Suite
import "../bspline3.zk"

fn test_bspline3():
    // Partition of unity: sum of all 4 basis functions must be 1.0
    t := 0.4
    sum_b := bspline_cubic_b0(t) + bspline_cubic_b1(t) + bspline_cubic_b2(t) + bspline_cubic_b3(t)
    if sum_b < 0.999: sys_exit(1)
    if sum_b > 1.001: sys_exit(1)
    print("test_bspline3 passed: cubic B-spline partition of unity verified")

fn main():
    test_bspline3()
    print("✓ All tests passed for cl-bspline-cubic-eval!")
