// cl-base64-encoded-len: Test Suite
import "../b64_elen.zk"

fn test_b64_elen():
    if base64_encoded_length(1) != 4: sys_exit(1)
    if base64_encoded_length(3) != 4: sys_exit(1)
    if base64_encoded_length(4) != 8: sys_exit(1)
    print("test_b64_elen passed")

fn main():
    test_b64_elen()
    print("✓ All tests passed for cl-base64-encoded-len!")
