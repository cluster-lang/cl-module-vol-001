// cl-char-is-alnum: Check If ASCII Value Is Alphanumeric [a-zA-Z0-9]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn char_is_alnum(c: int) -> int:
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57): return 1
    return 0
