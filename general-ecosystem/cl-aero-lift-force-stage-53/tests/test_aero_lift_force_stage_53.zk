// cl-aero-lift-force-stage-53: Test Suite
import "../lift_f_53.zk"

fn test_run():
    res := lift_force_53(100.0, 2.0, 0.5)
    diff := res - 5300.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-aero-lift-force-stage-53!")
