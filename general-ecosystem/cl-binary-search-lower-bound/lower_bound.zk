// Returns index of first element >= val, or len if none
fn lower_bound(arr: vector[int], val: int) -> int:
    lo := 0
    hi := arr.len()
    while lo < hi:
        mid := (lo + hi) / 2
        if arr[mid] < val:
            lo = mid + 1
        else:
            hi = mid
    return lo
