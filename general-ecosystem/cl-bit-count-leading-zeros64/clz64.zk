// cl-bit-count-leading-zeros64: 64-bit Leading Zeros Counter Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lshr64(val: int, shift: int) -> int:
    mask := (1 << (64 - shift)) - 1
    return (val >> shift) & mask

fn clz64(val: int) -> int:
    if val == 0: return 64
    count := 0
    i := 63
    cont := 1
    while cont == 1:
        if i >= 0:
            bit := lshr64(val, i) & 1
            if bit == 0:
                count = count + 1
                i = i - 1
            else:
                cont = 0
        else:
            cont = 0
    return count
