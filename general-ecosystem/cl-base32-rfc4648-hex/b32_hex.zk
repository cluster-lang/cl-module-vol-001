// cl-base32-rfc4648-hex: Base32 Extended Hex Alphabet Value
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

// '0'-'9' (0-9), 'A'-'V' (10-31)
fn base32_hex_value(c: int) -> int:
    if c >= 48:
        if c <= 57: return c - 48
    if c >= 65:
        if c <= 86: return 10 + (c - 65)
    return -1
