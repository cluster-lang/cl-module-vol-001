// cl-catmull-rom2d: Test Suite
import "../catmull2d.zk"

fn test_catmull2d():
    p := catmull_rom_2d_eval(0, 0, 10, 20, 30, 40, 50, 60, 0)
    if p[0] != 10: sys_exit(1)
    if p[1] != 20: sys_exit(1)
    print("test_catmull2d passed: 2D waypoint trajectory interpolation verified")

fn main():
    test_catmull2d()
    print("✓ All tests passed for cl-catmull-rom2d!")
