// cl-bspline-uniform-basis-linear: Test Suite
import "../bs_lin.zk"

fn test_bs_lin():
    b: vector[float] := [0.0, 0.0]
    bspline_linear_basis(0.4, b)
    diff0 := b[0] - 0.6
    if diff0 < 0.0: diff0 = 0.0 - diff0
    diff1 := b[1] - 0.4
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff0 > 0.0001 or diff1 > 0.0001: sys_exit(1)
    print("test_bs_lin passed")

fn main():
    test_bs_lin()
    print("✓ All tests passed for cl-bspline-uniform-basis-linear!")
