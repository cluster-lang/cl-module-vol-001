// cl-catmull-rom-tangent: Test Suite
import "../cr_tangent.zk"

fn test_cr_tangent():
    out: vector[float] := []
    catmull_rom_tangent(out, 0.0, 1.0, 2.0, 3.0, 0.5)
    if out.len() != 1: sys_exit(1)
    if out[0] < 0.99: sys_exit(1)
    if out[0] > 1.01: sys_exit(1)
    print("test_cr_tangent passed: spline tangent vector verified")

fn main():
    test_cr_tangent()
    print("✓ All tests passed for cl-catmull-rom-tangent!")
