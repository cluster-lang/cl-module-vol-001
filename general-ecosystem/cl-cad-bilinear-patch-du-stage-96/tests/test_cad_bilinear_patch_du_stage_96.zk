// cl-cad-bilinear-patch-du-stage-96: Test Suite
import "../cad_du_96.zk"

fn test_run():
    res := patch_du_96(1.0, 5.0)
    diff := res - 384.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-cad-bilinear-patch-du-stage-96!")
