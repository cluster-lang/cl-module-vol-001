// cl-base64-pad-count: Base64 Required Padding Bytes
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn base64_pad_count(byte_len: int) -> int:
    rem := byte_len % 3
    if rem == 1: return 2
    if rem == 2: return 1
    return 0
