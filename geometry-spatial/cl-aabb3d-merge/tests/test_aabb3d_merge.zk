// cl-aabb3d-merge: Test Suite
import "../aabb3d.zk"

fn test_aabb_merge():
    b1: vector[float] := [0.0, 0.0, 0.0, 2.0, 2.0, 2.0]
    b2: vector[float] := [-1.0, 1.0, 0.0, 1.0, 3.0, 4.0]
    out: vector[float] := []
    aabb3d_merge(out, b1, b2)
    if out[0] != -1.0: sys_exit(1)
    if out[4] != 3.0: sys_exit(1)
    if out[5] != 4.0: sys_exit(1)
    print("test_aabb_merge passed: bounding box union verified")

fn main():
    test_aabb_merge()
    print("✓ All tests passed for cl-aabb3d-merge!")
