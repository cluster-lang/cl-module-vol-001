// cl-aabb3d-merge: 3D Axis-Aligned Bounding Box Union
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn min_f(a: float, b: float) -> float:
    if a < b: return a
    return b

fn max_f(a: float, b: float) -> float:
    if a > b: return a
    return b

// Boxes: 6 floats [min_x, min_y, min_z, max_x, max_y, max_z]
fn aabb3d_merge(out: vector[float], b1: vector[float], b2: vector[float]):
    out.push(min_f(b1[0], b2[0]))
    out.push(min_f(b1[1], b2[1]))
    out.push(min_f(b1[2], b2[2]))
    out.push(max_f(b1[3], b2[3]))
    out.push(max_f(b1[4], b2[4]))
    out.push(max_f(b1[5], b2[5]))
